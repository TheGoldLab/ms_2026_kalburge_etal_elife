<?xml version='1.0' encoding='utf-8'?>
<PsychoPy2experiment encoding="utf-8" version="2023.1.2">
  <Settings>
    <Param val="use prefs" valType="str" updates="None" name="Audio latency priority" />
    <Param val="ptb" valType="str" updates="None" name="Audio lib" />
    <Param val="https://app.prolific.com/submissions/complete?cc=C1MSKA9I" valType="str" updates="None" name="Completed URL" />
    <Param val="auto" valType="str" updates="None" name="Data file delimiter" />
    <Param val="u'data/%s_%s_%s' % (expInfo['participant'], expName, expInfo['date'])" valType="code" updates="None" name="Data filename" />
    <Param val="True" valType="bool" updates="None" name="Enable Escape" />
    <Param val="" valType="str" updates="None" name="End Message" />
    <Param val="{'participant': '', 'session': '001'}" valType="code" updates="None" name="Experiment info" />
    <Param val="True" valType="bool" updates="None" name="Force stereo" />
    <Param val="True" valType="bool" updates="None" name="Full-screen window" />
    <Param val="" valType="str" updates="None" name="HTML path" />
    <Param val="" valType="str" updates="None" name="Incomplete URL" />
    <Param val="testMonitor" valType="str" updates="None" name="Monitor" />
    <Param val="['Resources/cactus.png', 'Resources/moon.png', 'Resources/Pigeon_change_InstructionsConditions.xlsx', 'Resources/Pigeon_fixed_InstructionsConditions.xlsx', 'Resources/Pigeon_mixed_InstructionsConditions.xlsx', 'Resources/pigeon.png', 'Resources/PigeonGeneralInstructionsConditions.xlsx', 'Resources/PigeonSimpleDemoConditions.xlsx', 'Resources/PigeonStatusInstructionsConditions.xlsx', 'Resources/PigeonTaskConditions.xlsx', 'Resources/seeds.png', 'Resources/sun.png', 'Resources/tree.png']" valType="list" updates="None" name="Resources" />
    <Param val="False" valType="bool" updates="None" name="Save csv file" />
    <Param val="False" valType="bool" updates="None" name="Save excel file" />
    <Param val="False" valType="bool" updates="None" name="Save hdf5 file" />
    <Param val="True" valType="bool" updates="None" name="Save log file" />
    <Param val="True" valType="bool" updates="None" name="Save psydat file" />
    <Param val="True" valType="bool" updates="None" name="Save wide csv file" />
    <Param val="1" valType="num" updates="None" name="Screen" />
    <Param val="True" valType="bool" updates="None" name="Show info dlg" />
    <Param val="False" valType="bool" updates="None" name="Show mouse" />
    <Param val="height" valType="str" updates="None" name="Units" />
    <Param val="" valType="str" updates="None" name="Use version" />
    <Param val="[1512, 982]" valType="list" updates="None" name="Window size (pixels)" />
    <Param val="none" valType="str" updates="None" name="backgroundFit" />
    <Param val="" valType="str" updates="None" name="backgroundImg" />
    <Param val="avg" valType="str" updates="None" name="blendMode" />
    <Param val="$[0,0,0]" valType="color" updates="None" name="color" />
    <Param val="rgb" valType="str" updates="None" name="colorSpace" />
    <Param val="100.1.1.1" valType="str" updates="None" name="elAddress" />
    <Param val="FILTER_LEVEL_2" valType="str" updates="None" name="elDataFiltering" />
    <Param val="FILTER_LEVEL_OFF" valType="str" updates="None" name="elLiveFiltering" />
    <Param val="EYELINK 1000 DESKTOP" valType="str" updates="None" name="elModel" />
    <Param val="ELLIPSE_FIT" valType="str" updates="None" name="elPupilAlgorithm" />
    <Param val="PUPIL_AREA" valType="str" updates="None" name="elPupilMeasure" />
    <Param val="1000" valType="num" updates="None" name="elSampleRate" />
    <Param val="False" valType="bool" updates="None" name="elSimMode" />
    <Param val="RIGHT_EYE" valType="str" updates="None" name="elTrackEyes" />
    <Param val="PUPIL_CR_TRACKING" valType="str" updates="None" name="elTrackingMode" />
    <Param val="pigeon_task" valType="str" updates="None" name="expName" />
    <Param val="on Sync" valType="str" updates="None" name="exportHTML" />
    <Param val="None" valType="str" updates="None" name="eyetracker" />
    <Param val="127.0.0.1" valType="str" updates="None" name="gpAddress" />
    <Param val="4242" valType="num" updates="None" name="gpPort" />
    <Param val="ioHub" valType="str" updates="None" name="keyboardBackend" />
    <Param val="exp" valType="code" updates="None" name="logging level" />
    <Param val="('MIDDLE_BUTTON',)" valType="list" updates="None" name="mgBlink" />
    <Param val="CONTINUOUS" valType="str" updates="None" name="mgMove" />
    <Param val="0.5" valType="num" updates="None" name="mgSaccade" />
    <Param val="0.6" valType="num" updates="None" name="plConfidenceThreshold" />
    <Param val="True" valType="bool" updates="None" name="plPupilCaptureRecordingEnabled" />
    <Param val="" valType="str" updates="None" name="plPupilCaptureRecordingLocation" />
    <Param val="127.0.0.1" valType="str" updates="None" name="plPupilRemoteAddress" />
    <Param val="50020" valType="num" updates="None" name="plPupilRemotePort" />
    <Param val="1000" valType="num" updates="None" name="plPupilRemoteTimeoutMs" />
    <Param val="False" valType="bool" updates="None" name="plPupillometryOnly" />
    <Param val="psychopy_iohub_surface" valType="str" updates="None" name="plSurfaceName" />
    <Param val="" valType="str" updates="None" name="tbLicenseFile" />
    <Param val="" valType="str" updates="None" name="tbModel" />
    <Param val="60" valType="num" updates="None" name="tbSampleRate" />
    <Param val="" valType="str" updates="None" name="tbSerialNo" />
    <Param val="pyglet" valType="str" updates="None" name="winBackend" />
  </Settings>
  <Routines>
    <Routine name="experiment_setup">
      <CodeComponent name="es_code_setup" plugin="None">
        <Param val="def calculate_median(arr):&amp;#10;    # Changepoint timing is always derived from the median RT (in steps) of the&amp;#10;    # preceding fixed-SNR block, rounded to an integer step count.&amp;#10;    if not arr:&amp;#10;        return 10&amp;#10;    arr.sort()&amp;#10;    n = len(arr)&amp;#10;    mid = n // 2&amp;#10;    if n % 2 == 0:&amp;#10;        med = (arr[mid - 1] + arr[mid]) / 2&amp;#10;    else:&amp;#10;        med = arr[mid]&amp;#10;    return round(med)&amp;#10;&amp;#10;&amp;#10;def trim_warmup_trials(arr):&amp;#10;    # Drops the first RT_WARMUP_TRIALS_TO_DISCARD entries (if enough trials exist)&amp;#10;    # before computing changepoint timing / RT-extremity stats, so early&amp;#10;    # &quot;getting used to the task&quot; RTs at the start of a block don't skew either.&amp;#10;    if len(arr) &gt; RT_WARMUP_TRIALS_TO_DISCARD:&amp;#10;        return arr[RT_WARMUP_TRIALS_TO_DISCARD:]&amp;#10;    return arr&amp;#10;&amp;#10;&amp;#10;def check_rt_extremity(rts):&amp;#10;    # Flags participants whose RT distribution on a fixed-SNR block is too extreme&amp;#10;    # to be usable: guessing on (almost) every trial (median RT below&amp;#10;    # RT_TOO_FAST_STEPS) or mostly not responding within the trial (median RT above&amp;#10;    # RT_TOO_SLOW_STEPS, or too large a fraction of trials timing out at&amp;#10;    # STEPS_MAX_PER_TRIAL). Returns None if the RTs look usable, otherwise a short&amp;#10;    # reason string used to end the session early.&amp;#10;    if not rts:&amp;#10;        return None&amp;#10;    sorted_rts = sorted(rts)&amp;#10;    n = len(sorted_rts)&amp;#10;    mid = n // 2&amp;#10;    if n % 2 == 0:&amp;#10;        median_rt = (sorted_rts[mid - 1] + sorted_rts[mid]) / 2&amp;#10;    else:&amp;#10;        median_rt = sorted_rts[mid]&amp;#10;    timeout_fraction = len([rt for rt in rts if rt &gt;= STEPS_MAX_PER_TRIAL]) / n&amp;#10;    if median_rt &lt; RT_TOO_FAST_STEPS:&amp;#10;        return &quot;too_fast&quot;&amp;#10;    if median_rt &gt; RT_TOO_SLOW_STEPS or timeout_fraction &gt; RT_TIMEOUT_FRACTION_MAX:&amp;#10;        return &quot;too_slow&quot;&amp;#10;    return None" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="// Changepoint timing is always derived from the median RT (in steps) of the preceding&amp;#10;// fixed-SNR block, rounded to an integer step count.&amp;#10;function calculate_median(arr) {&amp;#10;    if (arr.length === 0) return 10;&amp;#10;&amp;#10;    arr.sort((a, b) =&gt; a - b);&amp;#10;    let n = arr.length;&amp;#10;    let mid = Math.floor(n / 2);&amp;#10;&amp;#10;    return Math.round(n % 2 === 0 ? (arr[mid - 1] + arr[mid]) / 2 : arr[mid]);&amp;#10;}&amp;#10;&amp;#10;// Drops the first RT_WARMUP_TRIALS_TO_DISCARD entries (if enough trials exist) before&amp;#10;// computing changepoint timing / RT-extremity stats, so early &quot;getting used to the task&quot;&amp;#10;// RTs at the start of a block don't skew either.&amp;#10;function trim_warmup_trials(arr) {&amp;#10;    return arr.length &gt; RT_WARMUP_TRIALS_TO_DISCARD ? arr.slice(RT_WARMUP_TRIALS_TO_DISCARD) : arr;&amp;#10;}&amp;#10;&amp;#10;// Flags participants whose RT distribution on a fixed-SNR block is too extreme to be&amp;#10;// usable: guessing on (almost) every trial (median RT below RT_TOO_FAST_STEPS) or mostly&amp;#10;// not responding within the trial (median RT above RT_TOO_SLOW_STEPS, or too large a&amp;#10;// fraction of trials timing out at STEPS_MAX_PER_TRIAL). Returns null if the RTs look&amp;#10;// usable, otherwise a short reason string used to end the session early (see fm_code_setup).&amp;#10;function check_rt_extremity(rts) {&amp;#10;    if (rts.length === 0) return null;&amp;#10;    let sorted = rts.slice().sort((a, b) =&gt; a - b);&amp;#10;    let n = sorted.length;&amp;#10;    let mid = Math.floor(n / 2);&amp;#10;    let median_rt = n % 2 === 0 ? (sorted[mid - 1] + sorted[mid]) / 2 : sorted[mid];&amp;#10;    let timeout_fraction = rts.filter((rt) =&gt; rt &gt;= STEPS_MAX_PER_TRIAL).length / n;&amp;#10;    if (median_rt &lt; RT_TOO_FAST_STEPS) return &quot;too_fast&quot;;&amp;#10;    if (median_rt &gt; RT_TOO_SLOW_STEPS || timeout_fraction &gt; RT_TIMEOUT_FRACTION_MAX) return &quot;too_slow&quot;;&amp;#10;    return null;&amp;#10;}" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="# Global Settings&amp;#10;exp_type = 'snr' #'reward'&amp;#10;&amp;#10;# Global CONSTANTS and variables&amp;#10;&amp;#10;# Local variables needed in JS:&amp;#10;still_going = True&amp;#10;choice = ''&amp;#10;experiment_task_conditions_file = &quot;Resources/PigeonsTaskConditions&quot; + str(randint(1,4)) + &quot;.xlsx&quot;&amp;#10;dummy_mode = True&amp;#10;# Colors&amp;#10;# For JS:&amp;#10;#white = new util.Color([1, 1, 1]);&amp;#10;#grey = new util.Color([0.2, 0.2, 0.2]);&amp;#10;#yellow = new util.Color([1, 1, 0]);&amp;#10;#green = new util.Color([-1, 0, -1]);&amp;#10;#lightgreen = new util.Color([0, 1, 0]);&amp;#10;#black = new util.Color([-1, -1, -1]);&amp;#10;#red = new util.Color([1, 0, 0]);&amp;#10;white=[1,1,1]&amp;#10;grey=[0.2,0.2,0.2]&amp;#10;yellow=[1,1,0]&amp;#10;green=[-1,0,-1]&amp;#10;lightgreen=[0,1,0]&amp;#10;black=[-1,-1,-1]&amp;#10;red=[1,0,0]&amp;#10;&amp;#10;# Screen&amp;#10;ORIGIN_X = 0&amp;#10;ORIGIN_Y = 0&amp;#10;SEEDS_WIDTH = 0.1&amp;#10;SEEDS_HEIGHT = 0.1&amp;#10;EDGE_DISTANCE = 0.75&amp;#10;ENV_WIDTH = 0.15&amp;#10;ENV_HEIGHT = 0.1&amp;#10;ENV_X = EDGE_DISTANCE - 0.1&amp;#10;ENV_Y = ORIGIN_Y + 0.4&amp;#10;SEEDS_SCALE = 1;&amp;#10;&amp;#10;# Messages&amp;#10;INSTRUCTION_X = ORIGIN_X&amp;#10;INSTRUCTION_Y = 0.45&amp;#10;INSTRUCTION_COLOR = yellow&amp;#10;CHOICE_STRING = 'Press Left or Right arrow to choose'&amp;#10;CONTINUE_STRING = 'Press Spacebar or any arrow to continue'&amp;#10;PREDEFINED_CHOICE_STRING='Press Left/Up for small/large increases, Right/Down for small/large decreases,\nSpacebar to start the trial.'&amp;#10;PREDEFINED_CHOICE_COMMIT_STRING='Press Left/Up for small/large increases, Right/Down for small/large decreases,\nc to commit or Spacebar to start the trial.'&amp;#10;PREDEFINED_NO_CHOICE_STRING='Petey failed to reach the bound\nConsider moving it closer.'&amp;#10;PREDEFINED_ABORT_INSTRUCTION='Press Spacebar or any arrow to abort trial'&amp;#10;PREDEFINED_ABORT_STRING='Aborted early'&amp;#10;CORRECT_STRING='Correct'&amp;#10;ERROR_STRING='Error'&amp;#10;NO_CHOICE_STRING = 'Failed to respond\nPlease respond more quickly'&amp;#10;RT_TOO_FAST_MESSAGE = 'Session ended early.\n\nYour responses were consistently faster than this task requires to make a real decision. Thank you for participating.'&amp;#10;RT_TOO_SLOW_MESSAGE = 'Session ended early.\n\nYour responses were consistently slower than this task expects, or you were frequently not responding in time. Thank you for participating.'&amp;#10;MESSAGE_X = ORIGIN_X&amp;#10;MESSAGE_Y = 0.3&amp;#10;instruction_show = True&amp;#10;instruction_string = CONTINUE_STRING&amp;#10;message_show = True&amp;#10;message_string = ''&amp;#10;steps_string = ' '&amp;#10;coins_string = ' '&amp;#10;if exp_type == 'reward':&amp;#10;    high_env_img = 'Resources/tree.png'&amp;#10;    low_env_img = 'Resources/cactus.png'&amp;#10;elif exp_type == 'snr':&amp;#10;    high_env_img = 'Resources/sun.png'&amp;#10;    low_env_img = 'Resources/moon.png'&amp;#10;env_img = high_env_img&amp;#10;steps_label = 'Steps remaining'&amp;#10;steps_text = '200'&amp;#10;coins_text = '0'&amp;#10;step_mean_vals = []&amp;#10;step_std_vals = []&amp;#10;&amp;#10;# Status symbols&amp;#10;LINE_HEIGHT = 0.1&amp;#10;STATUS_BAR_HEIGHT = 0.2&amp;#10;STATUS_BAR_WIDTH = 0.1&amp;#10;ENV_BAR_HEIGHT = 0.02&amp;#10;ENV_BAR_WIDTH = 0.1&amp;#10;STATUS_BAR_BASE_Y = ORIGIN_Y-0.4&amp;#10;STATUS_BAR_APEX_Y = STATUS_BAR_BASE_Y+STATUS_BAR_HEIGHT&amp;#10;STATUS_BAR_BRACKET_WIDTH =  0.35&amp;#10;ABSCISSA_Y = ORIGIN_Y-0.05&amp;#10;ABSCISSA_WIDTH = EDGE_DISTANCE*2&amp;#10;ORDINATE_Y = ORIGIN_Y+0.05&amp;#10;ORDINATE_WIDTH = 0.2&amp;#10;ORDINATE_HEIGHT = 0.01&amp;#10;COINS_BAR_X = -0.1&amp;#10;COINS_TEXT_X = -0.1&amp;#10;COINS_TEXT_Y = -0.37&amp;#10;COINS_LABEL_TEXT_X = -0.28&amp;#10;COINS_LABEL_TEXT_Y = -0.2&amp;#10;COINS_PROPERTIES_TEXT_X = -0.55&amp;#10;COINS_PROPERTIES_TEXT_Y = -0.3&amp;#10;STEPS_BAR_X = 0.1&amp;#10;STEPS_TEXT_X = 0.1&amp;#10;STEPS_TEXT_Y = -0.37&amp;#10;STEPS_LABEL_TEXT_X = 0.35&amp;#10;STEPS_LABEL_TEXT_Y = -0.2&amp;#10;STEPS_PROPERTIES_TEXT_X = 0.55&amp;#10;STEPS_PROPERTIES_TEXT_Y = -0.3&amp;#10;steps_bar_height = 0&amp;#10;steps_bar_center = 0&amp;#10;coins_bar_height = 0&amp;#10;coins_bar_center = 0&amp;#10;env_bar_height = 0&amp;#10;env_bar_width = 0&amp;#10;env_bar_center = ENV_X - ENV_BAR_WIDTH/2&amp;#10;&amp;#10;# Predefined bound&amp;#10;PREDEFINED_BOUND_COLOR = green&amp;#10;PREDEFINED_BOUND_WIDTH = 0.2&amp;#10;PREDEFINED_BOUND_HEIGHT = 0.01&amp;#10;PREDEFINED_BOUND_Y = ORIGIN_Y+0.05&amp;#10;PREDEFINED_BOUND_SMALL_DELTA = 0.003&amp;#10;PREDEFINED_BOUND_LARGE_DELTA = 0.05&amp;#10;PREDEFINED_BOUND_X_DEFAULT = 0.05&amp;#10;PREDEFINED_BOUND_MARKER_SZ = 0.01&amp;#10;PREDEFINED_BOUND_MARKER_Y = 0.16&amp;#10;PREDEFINED_BOUND_MARKER_COLOR = lightgreen&amp;#10;predefined_bound_x = PREDEFINED_BOUND_X_DEFAULT&amp;#10;predefined_bound_x_previous = predefined_bound_x&amp;#10;committed_to_bound = False&amp;#10;predefined_bound_min_bonus = 0&amp;#10;predefined_bound_max_bonus = 0&amp;#10;min_steps_to_commit = 100&amp;#10;&amp;#10;# Stimulus display&amp;#10;seeds_show = False&amp;#10;pigeon_show = False&amp;#10;status_show = False&amp;#10;box_show = False&amp;#10;&amp;#10;# Timing/counting&amp;#10;UPDATE_INTERVAL = 0.200&amp;#10;ITI = 0.7&amp;#10;PREDEFINED_UPDATE_INTERVAL = 0.5&amp;#10;block_number = 0&amp;#10;cal_block_number = 0&amp;#10;test_block_number = 0&amp;#10;trial_number = 0&amp;#10;trial_start = True&amp;#10;bonus_count = 0&amp;#10;&amp;#10;# Task conditions&amp;#10;STEPS_MAX_PER_TRIAL = 50&amp;#10;low_switch_time = STEPS_MAX_PER_TRIAL&amp;#10;high_switch_time = STEPS_MAX_PER_TRIAL&amp;#10;# RT-extremity exclusion thresholds (in pigeon steps), from the 1st/99th percentiles of&amp;#10;# per-subject median RT on non-changepoint blocks in the existing cohort-3 (MXSC) data.&amp;#10;# Checked once at the end of each of the two fixed (non-changepoint) blocks.&amp;#10;RT_WARMUP_TRIALS_TO_DISCARD = 10&amp;#10;RT_TOO_FAST_STEPS = 3&amp;#10;RT_TOO_SLOW_STEPS = 25&amp;#10;RT_TIMEOUT_FRACTION_MAX = 0.2&amp;#10;should_exclude_participant = False&amp;#10;exclusion_message = ''&amp;#10;coins_gained_per_correct = 1&amp;#10;coins_lost_per_error = 1&amp;#10;coins_paid_to_start_trial = 0&amp;#10;coins_count = 0&amp;#10;coins_max = 100&amp;#10;steps_lost_per_error = 0&amp;#10;steps_taken_to_start_trial = 1&amp;#10;steps_count = 0&amp;#10;steps_in_trial = 0&amp;#10;steps_max = 11&amp;#10;step_mean_val = 0.02&amp;#10;step_std_val = 0.1&amp;#10;last_coins_count = 0&amp;#10;last_steps_count = 0&amp;#10;changepoint = False&amp;#10;&amp;#10;# Pigeon position&amp;#10;pigeon_flip = 0.1&amp;#10;pigeon_true_x = 0&amp;#10;pigeon_shown_x = pigeon_true_x&amp;#10;pigeon_steps = []&amp;#10;&amp;#10;# Function to move pigeon, depends on random variables&amp;#10;#   Note -- if you change this code, set code type to &amp;#10;#   &quot;Auto-&gt;JS&quot; first to make sure the JS code gets updated,&amp;#10;#   then set code type back to &quot;both&quot; and add the following&amp;#10;#   line at the top of this function:&amp;#10;#    global pigeon_flip, pigeon_true_x, pigeon_shown_x&amp;#10;def move_pigeon_function(step_mean, step_std):&amp;#10;    global pigeon_flip, pigeon_true_x, pigeon_shown_x&amp;#10;    &amp;#10;    for i in range(10):    &amp;#10;        u = 2*random()-1&amp;#10;        v = 2*random()-1&amp;#10;        r = u*u + v*v&amp;#10;        if r!=0 and r&lt;1:&amp;#10;            break&amp;#10;    new_step = step_mean + step_std*u*sqrt(-2*log(r)/r)&amp;#10;    if new_step &gt; 0:&amp;#10;        pigeon_flip = -0.1&amp;#10;    else:&amp;#10;        pigeon_flip = 0.1&amp;#10;&amp;#10;    pigeon_true_x = pigeon_true_x + new_step&amp;#10;    if pigeon_true_x &gt;= EDGE_DISTANCE:&amp;#10;        pigeon_shown_x = EDGE_DISTANCE&amp;#10;    elif pigeon_true_x &lt;= -EDGE_DISTANCE:&amp;#10;        pigeon_shown_x = -EDGE_DISTANCE&amp;#10;    else:&amp;#10;        pigeon_shown_x = pigeon_true_x&amp;#10;&amp;#10;def rng_trial_type_function():&amp;#10;    return random()&amp;#10;# Function to update status text/graphics&amp;#10;#   Note -- if you change this code, set code type to &amp;#10;#   &quot;Auto-&gt;JS&quot; first to make sure the JS code gets updated,&amp;#10;#   then set code type back to &quot;both&quot; and add the following&amp;#10;#   line at the top of this function:&amp;#10;#    global coins_string, steps_string, coins_bar_height, coins_bar_center, steps_bar_height, steps_bar_center&amp;#10;def update_status_function(update_text, update_coins_bar, update_steps_bar, update_env_bar, obj):&amp;#10;    global coins_string, steps_string, coins_bar_height, coins_bar_center, steps_bar_height, steps_bar_center, env_bar_width, env_bar_center&amp;#10;    &amp;#10;    # Conditionally update strings&amp;#10;    if update_text:&amp;#10;        coins_string = 'Coins gained per correct choice = ' + str(coins_gained_per_correct) + '\nCoins lost per error choice = ' + str(coins_lost_per_error)&amp;#10;        if obj == 'score':&amp;#10;            coins_string = 'Coins gained per correct choice = ' + str(coins_gained_per_correct) + '\nCoins lost per error choice = ' + str(coins_lost_per_error) + '\nTarget number of coins = ' + str(coins_max)&amp;#10;        steps_string = ''&amp;#10;        if obj == 'steps':&amp;#10;            steps_string = 'Total steps budget = ' + str(steps_max) &amp;#10;&amp;#10;    # Conditionally update coins bar&amp;#10;    if update_coins_bar:&amp;#10;        if coins_count &lt;= coins_max:&amp;#10;            coins_bar_height = coins_count/coins_max*STATUS_BAR_HEIGHT&amp;#10;        else:&amp;#10;            coins_bar_height = STATUS_BAR_HEIGHT+0.02&amp;#10;        coins_bar_center = STATUS_BAR_BASE_Y+coins_bar_height/2&amp;#10;&amp;#10;    # Conditionally update steps bar&amp;#10;    if update_steps_bar:&amp;#10;        if obj == 'steps':&amp;#10;            steps_bar_height = (steps_max-steps_count)/steps_max*STATUS_BAR_HEIGHT&amp;#10;        else:&amp;#10;            if steps_count &lt;= steps_max:&amp;#10;                steps_bar_height = (steps_count)/steps_max*STATUS_BAR_HEIGHT&amp;#10;            else:&amp;#10;                steps_bar_height = STATUS_BAR_HEIGHT+0.02&amp;#10;        steps_bar_center = STATUS_BAR_BASE_Y+steps_bar_height/2&amp;#10;        &amp;#10;    if update_env_bar:&amp;#10;        env_bar_width = (switch_time-steps_in_trial)/switch_time*ENV_BAR_WIDTH&amp;#10;        if steps_in_trial &gt;= switch_time:&amp;#10;            env_bar_width = 0&amp;#10;        env_bar_center = ENV_X - ENV_BAR_WIDTH/2 + env_bar_width/2&amp;#10;        &amp;#10;# Function to show feedback after each trial&amp;#10;#   Note -- if you change this code, set code type to &amp;#10;#   &quot;Auto-&gt;JS&quot; first to make sure the JS code gets updated,&amp;#10;#   then set code type back to &quot;both&quot; and add the following&amp;#10;#   line at the top of this function:&amp;#10;#   global last_coins_count, last_steps_count, message_string&amp;#10;def set_trial_end_string_function(feedback_string):&amp;#10;    global last_coins_count, last_steps_count, message_string&amp;#10;&amp;#10;    coins_change = coins_count - last_coins_count&amp;#10;    steps_change = steps_count - last_steps_count&amp;#10;    if coins_change &gt; 0:&amp;#10;        coins_feedback_string = str(coins_change) + ' coins gained'&amp;#10;    elif coins_change &lt; 0:&amp;#10;        coins_feedback_string = str(coins_change) + ' coins lost'&amp;#10;    else:&amp;#10;        coins_feedback_string = 'no coins gained or lost'&amp;#10;    &amp;#10;    message_string = feedback_string + '\n\n' + coins_feedback_string + '\n\n' + str(steps_change) + ' steps used this trial'&amp;#10;    last_coins_count = coins_count&amp;#10;    last_steps_count = steps_count&amp;#10;    &amp;#10;# Function to generate standard string at the end of each block&amp;#10;#   Note -- if you change this code, set code type to &amp;#10;#   &quot;Auto-&gt;JS&quot; first to make sure the JS code gets updated,&amp;#10;#   then set code type back to &quot;both&quot; and add the following&amp;#10;#   line at the top of this function:&amp;#10;#    global message_string, bonus_count, coins_count, coins_bar_height, coins_bar_center&amp;#10;def set_block_end_string_function(): &amp;#10;    global message_string, bonus_count, coins_count, coins_bar_height, coins_bar_center&amp;#10;    if (task_objective == 'steps' and coins_count &gt;= coins_max):                &amp;#10;        message_string='Block finished.\n\nYou earned a bonus. Great job!'&amp;#10;        bonus_count += 1&amp;#10;        coins_bar_height = STATUS_BAR_HEIGHT&amp;#10;        coins_bar_center = STATUS_BAR_BASE_Y+coins_bar_height/2&amp;#10;    else:&amp;#10;        message_string='Block finished.\n\nGreat job!'&amp;#10;        coins_bar_height = 0&amp;#10;        coins_bar_center = STATUS_BAR_BASE_Y &amp;#10;&amp;#10;&amp;#10;move_pigeon = move_pigeon_function&amp;#10;rng_trial_type = rng_trial_type_function&amp;#10;update_status = update_status_function&amp;#10;set_trial_end_string = set_trial_end_string_function&amp;#10;set_block_end_string = set_block_end_string_function&amp;#10;update_status(True, True, True, False, 'steps')" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="exp_type = 'snr';&amp;#10;still_going = true;&amp;#10;choice = &quot;&quot;;&amp;#10;//experiment_task_conditions_file = ((&quot;Resources/PigeonsTaskConditions&quot; + util.randint(1, 5).toString()) + &quot;.xlsx&quot;);&amp;#10;experiment_task_conditions_file = (&quot;Resources/PigeonsTaskConditions1.xlsx&quot;);&amp;#10;dummy_mode = false;&amp;#10;white = new util.Color([1, 1, 1]);&amp;#10;grey = new util.Color([0.2, 0.2, 0.2]);&amp;#10;yellow = new util.Color([1, 1, 0]);&amp;#10;green = new util.Color([-1, 0, -1]);&amp;#10;lightgreen = new util.Color([0, 1, 0]);&amp;#10;black = new util.Color([-1, -1, -1]);&amp;#10;red = new util.Color([1, 0, 0]);&amp;#10;ORIGIN_X = 0;&amp;#10;ORIGIN_Y = 0;&amp;#10;SEEDS_WIDTH = 0.1;&amp;#10;SEEDS_HEIGHT = 0.1;&amp;#10;EDGE_DISTANCE = 0.75;&amp;#10;ENV_WIDTH = 0.15&amp;#10;ENV_HEIGHT = 0.1&amp;#10;ENV_X = EDGE_DISTANCE - 0.1&amp;#10;ENV_Y = ORIGIN_Y + 0.4&amp;#10;SEEDS_SCALE = 1;&amp;#10;INSTRUCTION_X = ORIGIN_X;&amp;#10;INSTRUCTION_Y = 0.45;&amp;#10;INSTRUCTION_COLOR = yellow;&amp;#10;CHOICE_STRING = &quot;Press Left or Right arrow to choose&quot;;&amp;#10;CONTINUE_STRING = &quot;Press Spacebar or any arrow to continue&quot;;&amp;#10;PREDEFINED_CHOICE_STRING = &quot;Press Left/Up for small/large increases, Right/Down for small/large decreases,\nSpacebar to start the trial.&quot;;&amp;#10;PREDEFINED_CHOICE_COMMIT_STRING = &quot;Press Left/Up for small/large increases, Right/Down for small/large decreases,\nc to commit or Spacebar to start the trial.&quot;;&amp;#10;PREDEFINED_NO_CHOICE_STRING = &quot;Petey failed to reach the bound\nConsider moving it closer.&quot;;&amp;#10;PREDEFINED_ABORT_INSTRUCTION = &quot;Press Spacebar or any arrow to abort trial&quot;;&amp;#10;PREDEFINED_ABORT_STRING = &quot;Aborted early&quot;;&amp;#10;CORRECT_STRING = &quot;Correct&quot;;&amp;#10;ERROR_STRING = &quot;Error&quot;;&amp;#10;NO_CHOICE_STRING = &quot;Failed to respond\nPlease respond more quickly&quot;;&amp;#10;RT_TOO_FAST_MESSAGE = &quot;Session ended early.\n\nYour responses were consistently faster than this task requires to make a real decision. Thank you for participating.&quot;;&amp;#10;RT_TOO_SLOW_MESSAGE = &quot;Session ended early.\n\nYour responses were consistently slower than this task expects, or you were frequently not responding in time. Thank you for participating.&quot;;&amp;#10;MESSAGE_X = ORIGIN_X;&amp;#10;MESSAGE_Y = 0.3;&amp;#10;instruction_show = true;&amp;#10;instruction_string = CONTINUE_STRING;&amp;#10;message_show = true;&amp;#10;message_string = &quot;&quot;;&amp;#10;steps_string = &quot; &quot;;&amp;#10;coins_string = &quot; &quot;;&amp;#10;if ((exp_type === &quot;reward&quot;)) {&amp;#10;    high_env_img = &quot;Resources/tree.png&quot;;&amp;#10;    low_env_img = &quot;Resources/cactus.png&quot;;&amp;#10;} else {&amp;#10;    if ((exp_type === &quot;snr&quot;)) {&amp;#10;        high_env_img = &quot;Resources/sun.png&quot;;&amp;#10;        low_env_img = &quot;Resources/moon.png&quot;;&amp;#10;    }&amp;#10;}&amp;#10;env_img = high_env_img;&amp;#10;steps_label = 'Steps remaining';&amp;#10;steps_text = '200';&amp;#10;coins_text = '0';&amp;#10;step_mean_vals = [];&amp;#10;step_std_vals = [];&amp;#10;&amp;#10;LINE_HEIGHT = 0.1;&amp;#10;STATUS_BAR_HEIGHT = 0.2;&amp;#10;STATUS_BAR_WIDTH = 0.1;&amp;#10;ENV_BAR_HEIGHT = 0.02;&amp;#10;ENV_BAR_WIDTH = 0.1&amp;#10;STATUS_BAR_BASE_Y = (ORIGIN_Y - 0.4);&amp;#10;STATUS_BAR_APEX_Y = (STATUS_BAR_BASE_Y + STATUS_BAR_HEIGHT);&amp;#10;STATUS_BAR_BRACKET_WIDTH = 0.35;&amp;#10;ABSCISSA_Y = (ORIGIN_Y - 0.05);&amp;#10;ABSCISSA_WIDTH = (EDGE_DISTANCE * 2);&amp;#10;ORDINATE_Y = (ORIGIN_Y + 0.05);&amp;#10;ORDINATE_WIDTH = 0.2;&amp;#10;ORDINATE_HEIGHT = 0.01;&amp;#10;COINS_BAR_X = (- 0.1);&amp;#10;COINS_TEXT_X = (- 0.1);&amp;#10;COINS_TEXT_Y = (- 0.37);&amp;#10;COINS_LABEL_TEXT_X = (- 0.28);&amp;#10;COINS_LABEL_TEXT_Y = (- 0.2);&amp;#10;COINS_PROPERTIES_TEXT_X = (- 0.55);&amp;#10;COINS_PROPERTIES_TEXT_Y = (- 0.3);&amp;#10;STEPS_BAR_X = 0.1;&amp;#10;STEPS_TEXT_X = 0.1;&amp;#10;STEPS_TEXT_Y = (- 0.37);&amp;#10;STEPS_LABEL_TEXT_X = 0.35;&amp;#10;STEPS_LABEL_TEXT_Y = (- 0.2);&amp;#10;STEPS_PROPERTIES_TEXT_X = 0.55;&amp;#10;STEPS_PROPERTIES_TEXT_Y = (- 0.3);&amp;#10;steps_bar_height = 0;&amp;#10;steps_bar_center = 0;&amp;#10;coins_bar_height = 0;&amp;#10;coins_bar_center = 0;&amp;#10;env_bar_height = 0;&amp;#10;env_bar_width = 0;&amp;#10;env_bar_center = ENV_X - ENV_BAR_WIDTH/2;&amp;#10;PREDEFINED_BOUND_COLOR = green;&amp;#10;PREDEFINED_BOUND_WIDTH = 0.2;&amp;#10;PREDEFINED_BOUND_HEIGHT = 0.01;&amp;#10;PREDEFINED_BOUND_Y = (ORIGIN_Y + 0.05);&amp;#10;PREDEFINED_BOUND_SMALL_DELTA = 0.003;&amp;#10;PREDEFINED_BOUND_LARGE_DELTA = 0.05;&amp;#10;PREDEFINED_BOUND_X_DEFAULT = 0.05;&amp;#10;PREDEFINED_BOUND_MARKER_SZ = 0.01;&amp;#10;PREDEFINED_BOUND_MARKER_Y = 0.16;&amp;#10;PREDEFINED_BOUND_MARKER_COLOR = lightgreen;&amp;#10;predefined_bound_x = PREDEFINED_BOUND_X_DEFAULT;&amp;#10;predefined_bound_x_previous = predefined_bound_x;&amp;#10;committed_to_bound = false;&amp;#10;predefined_bound_min_bonus = 0;&amp;#10;predefined_bound_max_bonus = 0;&amp;#10;min_steps_to_commit = 100;&amp;#10;seeds_show = false;&amp;#10;pigeon_show = false;&amp;#10;status_show = false;&amp;#10;box_show = false;&amp;#10;UPDATE_INTERVAL = 0.200;&amp;#10;ITI = 0.7;&amp;#10;PREDEFINED_UPDATE_INTERVAL = 0.1;&amp;#10;block_number = 0;&amp;#10;cal_block_number = 0;&amp;#10;test_block_number = 0;&amp;#10;trial_number = 0;&amp;#10;trial_start = true;&amp;#10;bonus_count = 0;&amp;#10;&amp;#10;STEPS_MAX_PER_TRIAL = 50;&amp;#10;low_switch_time = STEPS_MAX_PER_TRIAL;&amp;#10;high_switch_time = STEPS_MAX_PER_TRIAL;&amp;#10;RT_WARMUP_TRIALS_TO_DISCARD = 10;&amp;#10;RT_TOO_FAST_STEPS = 3;&amp;#10;RT_TOO_SLOW_STEPS = 25;&amp;#10;RT_TIMEOUT_FRACTION_MAX = 0.2;&amp;#10;should_exclude_participant = false;&amp;#10;exclusion_message = &quot;&quot;;&amp;#10;coins_gained_per_correct = 1;&amp;#10;coins_lost_per_error = 1;&amp;#10;coins_paid_to_start_trial = 0;&amp;#10;coins_count = 0;&amp;#10;coins_max = 8;&amp;#10;steps_lost_per_error = 0;&amp;#10;steps_taken_to_start_trial = 1;&amp;#10;steps_count = 0;&amp;#10;steps_max = 11;&amp;#10;step_mean_val = 0.02;&amp;#10;step_std_val = 0.1;&amp;#10;last_coins_count = 0;&amp;#10;last_steps_count = 0;&amp;#10;changepoint = false;&amp;#10;&amp;#10;pigeon_flip = 0.1;&amp;#10;pigeon_true_x = 0;&amp;#10;pigeon_shown_x = pigeon_true_x;&amp;#10;pigeon_steps = [];&amp;#10;&amp;#10;function move_pigeon_function(step_mean, step_std) {&amp;#10;    var new_step, r, u, v;&amp;#10;    for (var i, _pj_c = 0, _pj_a = util.range(10), _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;        i = _pj_a[_pj_c];&amp;#10;        u = ((2 * Math.random()) - 1);&amp;#10;        v = ((2 * Math.random()) - 1);&amp;#10;        r = ((u * u) + (v * v));&amp;#10;        if (((r !== 0) &amp;&amp; (r &lt; 1))) {&amp;#10;            break;&amp;#10;        }&amp;#10;    }&amp;#10;    new_step = (step_mean + ((step_std * u) * Math.sqrt((((- 2) * Math.log(r)) / r))));&amp;#10;    if ((new_step &gt; 0)) {&amp;#10;        pigeon_flip = (- 0.1);&amp;#10;    } else {&amp;#10;        pigeon_flip = 0.1;&amp;#10;    }&amp;#10;    pigeon_true_x = (pigeon_true_x + new_step);&amp;#10;    if ((pigeon_true_x &gt;= EDGE_DISTANCE)) {&amp;#10;        pigeon_shown_x = EDGE_DISTANCE;&amp;#10;    } else {&amp;#10;        if ((pigeon_true_x &lt;= (- EDGE_DISTANCE))) {&amp;#10;            pigeon_shown_x = (- EDGE_DISTANCE);&amp;#10;        } else {&amp;#10;            pigeon_shown_x = pigeon_true_x;&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;function rng_trial_type_function() {&amp;#10;    var x;&amp;#10;    x = Math.random();&amp;#10;    return x;&amp;#10;}&amp;#10;function update_status_function(update_text, update_coins_bar, update_steps_bar, update_env_bar, obj) {&amp;#10;    if (update_text) {&amp;#10;        coins_string = (((&quot;Coins gained per correct choice = &quot; + coins_gained_per_correct.toString()) + &quot;\nCoins lost per error choice = &quot;) + coins_lost_per_error.toString());&amp;#10;        if ((obj === &quot;score&quot;)) {&amp;#10;            coins_string = (((((&quot;Coins gained per correct choice = &quot; + coins_gained_per_correct.toString()) + &quot;\nCoins lost per error choice = &quot;) + coins_lost_per_error.toString()) + &quot;\nTarget number of coins = &quot;) + coins_max.toString());&amp;#10;        }&amp;#10;        steps_string = &quot;&quot;;&amp;#10;        if ((obj === &quot;steps&quot;)) {&amp;#10;            steps_string = (&quot;Total steps budget = &quot; + steps_max.toString());&amp;#10;        }&amp;#10;    }&amp;#10;    if (update_coins_bar) {&amp;#10;        if ((coins_count &lt;= coins_max)) {&amp;#10;            coins_bar_height = ((coins_count / coins_max) * STATUS_BAR_HEIGHT);&amp;#10;        } else {&amp;#10;            coins_bar_height = (STATUS_BAR_HEIGHT + 0.02);&amp;#10;        }&amp;#10;        coins_bar_center = (STATUS_BAR_BASE_Y + (coins_bar_height / 2));&amp;#10;    }&amp;#10;    if (update_steps_bar) {&amp;#10;        if ((obj === &quot;steps&quot;)) {&amp;#10;            steps_bar_height = (((steps_max - steps_count) / steps_max) * STATUS_BAR_HEIGHT);&amp;#10;        } else {&amp;#10;            if ((steps_count &lt;= steps_max)) {&amp;#10;                steps_bar_height = ((steps_count / steps_max) * STATUS_BAR_HEIGHT);&amp;#10;            } else {&amp;#10;                steps_bar_height = (STATUS_BAR_HEIGHT + 0.02);&amp;#10;            }&amp;#10;        }&amp;#10;        steps_bar_center = (STATUS_BAR_BASE_Y + (steps_bar_height / 2));&amp;#10;    }&amp;#10;    if (update_env_bar) {&amp;#10;        env_bar_width = (((switch_time - steps_in_trial) / switch_time) * ENV_BAR_WIDTH);&amp;#10;        if ((steps_in_trial &gt;= switch_time)) {&amp;#10;            env_bar_width = 0;&amp;#10;        }&amp;#10;        env_bar_center = (ENV_X - ENV_BAR_WIDTH/2 + (env_bar_width / 2));&amp;#10;    }&amp;#10;&amp;#10;}&amp;#10;function set_trial_end_string_function(feedback_string) {&amp;#10;    var coins_change, coins_feedback_string, steps_change;&amp;#10;    coins_change = (coins_count - last_coins_count);&amp;#10;    steps_change = (steps_count - last_steps_count);&amp;#10;    if ((coins_change &gt; 0)) {&amp;#10;        coins_feedback_string = (coins_change.toString() + &quot; coins gained&quot;);&amp;#10;    } else {&amp;#10;        if ((coins_change &lt; 0)) {&amp;#10;            coins_feedback_string = (coins_change.toString() + &quot; coins lost&quot;);&amp;#10;        } else {&amp;#10;            coins_feedback_string = &quot;no coins gained or lost&quot;;&amp;#10;        }&amp;#10;    }&amp;#10;    message_string = (((((feedback_string + &quot;\n\n&quot;) + coins_feedback_string) + &quot;\n\n&quot;) + steps_change.toString()) + &quot; steps used this trial&quot;);&amp;#10;    last_coins_count = coins_count;&amp;#10;    last_steps_count = steps_count;&amp;#10;}&amp;#10;&amp;#10;function set_block_end_string_function() {&amp;#10;    if (((task_objective === &quot;steps&quot;) &amp;&amp; (coins_count &gt;= coins_max))) {&amp;#10;        message_string = &quot;Block finished.\n\nYou earned a bonus. Great job!&quot;;&amp;#10;        bonus_count += 1;&amp;#10;        coins_bar_height = STATUS_BAR_HEIGHT;&amp;#10;        coins_bar_center = (STATUS_BAR_BASE_Y + (coins_bar_height / 2));&amp;#10;    } else {&amp;#10;        message_string = &quot;Block finished.\n\nGreat job!&quot;;&amp;#10;        coins_bar_height = 0;&amp;#10;        coins_bar_center = STATUS_BAR_BASE_Y;&amp;#10;    }&amp;#10;}&amp;#10;&amp;#10;move_pigeon = move_pigeon_function;&amp;#10;rng_trial_type = rng_trial_type_function;&amp;#10;update_status = update_status_function;&amp;#10;set_trial_end_string = set_trial_end_string_function;&amp;#10;set_block_end_string = set_block_end_string_function;&amp;#10;update_status(true, true, true, false, &quot;steps&quot;);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
