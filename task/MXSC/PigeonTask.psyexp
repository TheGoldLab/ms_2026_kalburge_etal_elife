    <Routine name="speed_loop_setup">
      <CodeComponent name="sls_code_setup" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="UPDATE_INTERVAL = sc_update_interval;&amp;#10;message_string = &quot;Get ready!&quot;;&amp;#10;trial_start = true;&amp;#10;trial_number = 1;&amp;#10;steps_count = 0;&amp;#10;coins_count = 0;&amp;#10;last_coins_count = coins_count;&amp;#10;last_steps_count = steps_count;&amp;#10;RT = [];&amp;#10;switch_occurred = false;&amp;#10;correct_streak = 0;&amp;#10;incorrect_streak = 0;&amp;#10;reversals = 0;&amp;#10;low_switch_time = STEPS_MAX_PER_TRIAL;&amp;#10;high_switch_time = STEPS_MAX_PER_TRIAL;&amp;#10;high_steps_thresh = 0;&amp;#10;low_steps_thresh = 0;&amp;#10;last_coins_count = 0;&amp;#10;last_steps_count = 0;&amp;#10;if_switch = false;&amp;#10;pigeon_flip = 0.1;&amp;#10;pigeon_true_x = 0;&amp;#10;pigeon_shown_x = pigeon_true_x;&amp;#10;update_status(true, true, true, false, task_objective);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="#set speed&amp;#10;UPDATE_INTERVAL = sc_update_interval&amp;#10;#message_string = &quot;In these next few blocks, Petey's movements will be &quot; + sc_type + &quot;.&quot;&amp;#10;message_string = 'Get ready!'&amp;#10;trial_start = True&amp;#10;trial_number = 1&amp;#10;steps_count = 0&amp;#10;coins_count = 0&amp;#10;last_coins_count = coins_count&amp;#10;last_steps_count = steps_count&amp;#10;RT = []&amp;#10;switch_occurred = False&amp;#10;correct_streak = 0&amp;#10;incorrect_streak = 0&amp;#10;reversals = 0&amp;#10;low_switch_time = STEPS_MAX_PER_TRIAL&amp;#10;high_switch_time = STEPS_MAX_PER_TRIAL&amp;#10;high_steps_thresh = 0&amp;#10;low_steps_thresh = 0&amp;#10;last_coins_count = 0&amp;#10;last_steps_count = 0&amp;#10;if_switch = False&amp;#10;&amp;#10;&amp;#10;&amp;#10;# Initialize pigeon variables&amp;#10;pigeon_flip = 0.1&amp;#10;pigeon_true_x = 0&amp;#10;pigeon_shown_x = pigeon_true_x&amp;#10;&amp;#10;# Update status graphics/text&amp;#10;update_status(True, True, True, False, task_objective)" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="sls_code_setup" valType="code" updates="None" name="name" />
      </CodeComponent>
    </Routine>
  </Routines>
  <Flow>
    <Routine name="consent" />
    <Routine name="experiment_setup" />
    <LoopInitiator loopType="TrialHandler" name="general_instructions_loop">
      <Param name="Selected rows" updates="None" val="" valType="str" />
      <Param name="conditions" updates="None" val="[{'gic_message': 'Hi!\nThank you for participating in this experiment.\nPressing Esc will end this session.', 'gic_pigeon_show': False, 'gic_seeds_show': False}, {'gic_message': 'This is Petey the Pigeon.', 'gic_pigeon_show': True, 'gic_seeds_show': False}, {'gic_message': 'Petey is very hungry and sees two piles of seeds nearby. However, one pile is good and the other has gone bad.\nIn this task, you will see Petey walking back and forth between the piles to figure out which one he should eat. He will gradually tend toward the correct pile and remain there, but your job is to predict which pile that is before that happens.', 'gic_pigeon_show': True, 'gic_seeds_show': True}, {'gic_message': &quot;Let's see Petey move!&quot;, 'gic_pigeon_show': True, 'gic_seeds_show': True}]" valType="str" />
      <Param name="conditionsFile" updates="None" val="Resources/PigeonGeneralInstructionsConditions.xlsx" valType="file" />
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num" />
      <Param name="isTrials" updates="None" val="False" valType="bool" />
      <Param name="loopType" updates="None" val="sequential" valType="str" />
      <Param name="nReps" updates="None" val="1" valType="num" />
      <Param name="name" updates="None" val="general_instructions_loop" valType="code" />
      <Param name="random seed" updates="None" val="" valType="code" />
    </LoopInitiator>
    <Routine name="general_instructions_setup" />
    <Routine name="show_message" />
    <LoopTerminator name="general_instructions_loop" />
    <LoopInitiator loopType="TrialHandler" name="simple_demo_block_loop">
      <Param name="Selected rows" updates="None" val="" valType="str" />
      <Param name="conditions" updates="None" val="[{'sdc_message': 'In the forest, Petey will have more to eat, so he will receive more coins for correct decisions.', 'sdc_step_mean': 0.05, 'sdc_step_std': 0.1, 'sdc_img_file': 'tree.png', 'sdc_seeds_scale': 1}, {'sdc_message': 'In the desert, Petey has less to eat, so he will receive fewer coins for correct decisions.', 'sdc_step_mean': 0.02, 'sdc_step_std': 0.1, 'sdc_img_file': 'cactus.png', 'sdc_seeds_scale': 0.8}]" valType="str" />
      <Param name="conditionsFile" updates="None" val="Resources/PigeonSimpleDemoConditions.xlsx" valType="file" />
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num" />
      <Param name="isTrials" updates="None" val="False" valType="bool" />
      <Param name="loopType" updates="None" val="sequential" valType="str" />
      <Param name="nReps" updates="None" val="1" valType="num" />
      <Param name="name" updates="None" val="simple_demo_block_loop" valType="code" />
      <Param name="random seed" updates="None" val="" valType="code" />
    </LoopInitiator>
    <Routine name="simple_demo_setup" />
    <Routine name="show_message" />
    <LoopInitiator loopType="TrialHandler" name="simple_demo_trial_loop">
      <Param name="Selected rows" updates="None" val="" valType="str" />
      <Param name="conditions" updates="None" val="None" valType="str" />
      <Param name="conditionsFile" updates="None" val="" valType="file" />
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num" />
      <Param name="isTrials" updates="None" val="False" valType="bool" />
      <Param name="loopType" updates="None" val="sequential" valType="str" />
      <Param name="nReps" updates="None" val="1000" valType="num" />
      <Param name="name" updates="None" val="simple_demo_trial_loop" valType="code" />
      <Param name="random seed" updates="None" val="" valType="code" />
    </LoopInitiator>
    <Routine name="simple_demo" />
    <LoopTerminator name="simple_demo_trial_loop" />
    <LoopTerminator name="simple_demo_block_loop" />
    <LoopInitiator loopType="TrialHandler" name="status_instruction_loop">
      <Param name="Selected rows" updates="None" val="" valType="str" />
      <Param name="conditions" updates="None" val="[{'sic_message': 'Great!', 'sic_box_show': False, 'sic_box_x': 0, 'sic_box_y': 0, 'sic_box_width': 0, 'sic_box_height': 0, 'sdc_img_file': 'sun.png'}, {'sic_message': &quot;Now that you have the basic idea, let's get started with the task.&quot;, 'sic_box_show': None, 'sic_box_x': None, 'sic_box_y': None, 'sic_box_width': None, 'sic_box_height': None, 'sdc_img_file': None}, {'sic_message': 'Your job is to determine, as quickly and accurately as possible, which seeds Petey will choose on each given trial, based on his initial movements.', 'sic_box_show': False, 'sic_box_x': 0, 'sic_box_y': 0, 'sic_box_width': 0, 'sic_box_height': 0, 'sdc_img_file': 'sun.png'}, {'sic_message': &quot;We show a black line where Petey starts and a white line at Petey's midpoint so you can see exactly how far away he has moved in either direction.&quot;, 'sic_box_show': True, 'sic_box_x': 0, 'sic_box_y': 0, 'sic_box_width': 0.25, 'sic_box_height': 0.25, 'sdc_img_file': 'sun.png'}, {'sic_message': 'You will receive coins for each correct answer and\xa0 may lose coins for each incorrect answer. You also may have to pay coins to start each trial. You may get a bonus for reaching a certain number of coins.', 'sic_box_show': True, 'sic_box_x': -0.55, 'sic_box_y': -0.3, 'sic_box_width': 0.4, 'sic_box_height': 0.15, 'sdc_img_file': 'sun.png'}, {'sic_message': 'This section shows the settings for the current block of trials.', 'sic_box_show': True, 'sic_box_x': -0.55, 'sic_box_y': -0.3, 'sic_box_width': 0.4, 'sic_box_height': 0.15, 'sdc_img_file': 'sun.png'}, {'sic_message': 'This bar tells you how many coins you have earned so far.', 'sic_box_show': True, 'sic_box_x': -0.15, 'sic_box_y': -0.3, 'sic_box_width': 0.3, 'sic_box_height': 0.3, 'sdc_img_file': 'sun.png'}, {'sic_message': 'Petey is willing to walk only a certain number of steps during a block of trials, so if you wait too long to decide you will run out of steps more quickly and miss out on rewards. Petey also may have to take a certain number of steps before starting each trial.', 'sic_box_show': True, 'sic_box_x': 0.55, 'sic_box_y': -0.3, 'sic_box_width': 0.4, 'sic_box_height': 0.15, 'sdc_img_file': 'sun.png'}, {'sic_message': 'This section shows the settings for the current block of trials', 'sic_box_show': True, 'sic_box_x': 0.55, 'sic_box_y': -0.3, 'sic_box_width': 0.4, 'sic_box_height': 0.15, 'sdc_img_file': 'sun.png'}, {'sic_message': 'This bar tells you how many more steps Petey has left. When the bar hits zero, the block will end.', 'sic_box_show': True, 'sic_box_x': 0.15, 'sic_box_y': -0.3, 'sic_box_width': 0.3, 'sic_box_height': 0.3, 'sdc_img_file': 'sun.png'}, {'sic_message': 'So your performance will depend on both guessing correctly and not wasting too many steps.', 'sic_box_show': False, 'sic_box_x': 0, 'sic_box_y': 0, 'sic_box_width': 0, 'sic_box_height': 0, 'sdc_img_file': 'sun.png'}, {'sic_message': &quot;Let's get started!&quot;, 'sic_box_show': None, 'sic_box_x': None, 'sic_box_y': None, 'sic_box_width': None, 'sic_box_height': None, 'sdc_img_file': None}, {'sic_message': 'Each block will start with a description of the conditions.', 'sic_box_show': None, 'sic_box_x': None, 'sic_box_y': None, 'sic_box_width': None, 'sic_box_height': None, 'sdc_img_file': None}]" valType="str" />
      <Param name="conditionsFile" updates="None" val="Resources/PigeonStatusInstructionsConditions.xlsx" valType="file" />
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num" />
      <Param name="isTrials" updates="None" val="False" valType="bool" />
      <Param name="loopType" updates="None" val="sequential" valType="str" />
      <Param name="nReps" updates="None" val="1" valType="num" />
      <Param name="name" updates="None" val="status_instruction_loop" valType="code" />
      <Param name="random seed" updates="None" val="" valType="code" />
    </LoopInitiator>
    <Routine name="status_instruction_setup" />
    <Routine name="show_message" />
    <LoopTerminator name="status_instruction_loop" />
    <LoopInitiator loopType="TrialHandler" name="experiment_loop">
      <Param name="Selected rows" updates="None" val="" valType="str" />
      <Param name="conditions" updates="None" val="[{'tc_block_type': 'fixed-low', 'tc_steps_max': 600, 'tc_steps_taken_to_start_trial': 1, 'tc_steps_lost_per_error': 0, 'tc_coins_max': 150, 'tc_coins_paid_to_start_trial': 0, 'tc_coins_lost_per_error': 1, 'tc_coins_gained_per_correct': 1, 'tc_img_file': 'sun.png', 'tc_switch': True}, {'tc_block_type': 'fixed-high', 'tc_steps_max': 600, 'tc_steps_taken_to_start_trial': 1, 'tc_steps_lost_per_error': 0, 'tc_coins_max': 150, 'tc_coins_paid_to_start_trial': 0, 'tc_coins_lost_per_error': 1, 'tc_coins_gained_per_correct': 1, 'tc_img_file': 'sun.png', 'tc_switch': True}, {'tc_block_type': 'mixed', 'tc_steps_max': 600, 'tc_steps_taken_to_start_trial': 1, 'tc_steps_lost_per_error': 0, 'tc_coins_max': 150, 'tc_coins_paid_to_start_trial': 0, 'tc_coins_lost_per_error': 1, 'tc_coins_gained_per_correct': 1, 'tc_img_file': 'sun.png', 'tc_switch': True}, {'tc_block_type': 'change-low', 'tc_steps_max': 600, 'tc_steps_taken_to_start_trial': 1, 'tc_steps_lost_per_error': 0, 'tc_coins_max': 150, 'tc_coins_paid_to_start_trial': 0, 'tc_coins_lost_per_error': 1, 'tc_coins_gained_per_correct': 1, 'tc_img_file': 'sun.png', 'tc_switch': True}, {'tc_block_type': 'change-high', 'tc_steps_max': 600, 'tc_steps_taken_to_start_trial': 1, 'tc_steps_lost_per_error': 0, 'tc_coins_max': 150, 'tc_coins_paid_to_start_trial': 0, 'tc_coins_lost_per_error': 1, 'tc_coins_gained_per_correct': 1, 'tc_img_file': 'sun.png', 'tc_switch': True}]" valType="str" />
      <Param name="conditionsFile" updates="None" val="Resources/PigeonTaskConditions.xlsx" valType="file" />
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num" />
      <Param name="isTrials" updates="None" val="True" valType="bool" />
      <Param name="loopType" updates="None" val="sequential" valType="str" />
      <Param name="nReps" updates="None" val="1" valType="num" />
      <Param name="name" updates="None" val="experiment_loop" valType="code" />
      <Param name="random seed" updates="None" val="" valType="code" />
    </LoopInitiator>
