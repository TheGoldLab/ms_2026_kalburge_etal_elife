        <Param val="sc_code_setup" valType="code" updates="None" name="name" />
      </CodeComponent>
    </Routine>
    <Routine name="calibration_run">
      <KeyboardComponent name="cr_kbd_response" plugin="None">
        <Param val="'left','right'" valType="list" updates="constant" name="allowedKeys" />
        <Param val="" valType="str" updates="constant" name="correctAns" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="False" valType="bool" updates="constant" name="discard previous" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="True" valType="bool" updates="constant" name="forceEndRoutine" />
        <Param val="cr_kbd_response" valType="code" updates="None" name="name" />
        <Param val="press" valType="str" updates="constant" name="registerOn" />
        <Param val="False" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="code" updates="None" name="startEstim" />
        <Param val="time (s)" valType="str" updates="None" name="startType" />
        <Param val="0.0" valType="code" updates="None" name="startVal" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="UPDATE_INTERVAL" valType="code" updates="constant" name="stopVal" />
        <Param val="nothing" valType="str" updates="constant" name="store" />
        <Param val="False" valType="bool" updates="constant" name="storeCorrect" />
        <Param val="True" valType="bool" updates="constant" name="syncScreenRefresh" />
      </KeyboardComponent>
      <CodeComponent name="cr_code_update" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="if (((steps_count === steps_max) &amp;&amp; (steps_count &lt; 1500))) {&amp;#10;    steps_max += 250;&amp;#10;} else {&amp;#10;    if ((steps_count &gt;= 1250)) {&amp;#10;        steps_max = ((coins_max * STEPS_MAX_PER_TRIAL) / coins_gained_per_correct);&amp;#10;    }&amp;#10;}&amp;#10;steps_label = (&quot;Steps Threshold: &quot; + steps_max.toString());&amp;#10;if ((trial_start === true)) {&amp;#10;    cr_kbd_response.clearEvents();&amp;#10;    message_string = NO_CHOICE_STRING;&amp;#10;    choice = &quot;none&quot;;&amp;#10;    instruction_string = CHOICE_STRING;&amp;#10;    pigeon_flip = 0.1;&amp;#10;    pigeon_true_x = ORIGIN_X;&amp;#10;    pigeon_shown_x = pigeon_true_x;&amp;#10;    pigeon_steps = [pigeon_shown_x];&amp;#10;    if ((util.randint(0, 2) === 1)) {&amp;#10;        correct_ans = &quot;right&quot;;&amp;#10;        step_mean_val = Math.abs(step_mean);&amp;#10;    } else {&amp;#10;        correct_ans = &quot;left&quot;;&amp;#10;        step_mean_val = ((- 1) * Math.abs(step_mean));&amp;#10;    }&amp;#10;    step_std_val = step_std;&amp;#10;    psychoJS.experiment.addData(&quot;step_mean_val&quot;, step_mean_val);&amp;#10;    psychoJS.experiment.addData(&quot;step_std_val&quot;, step_std_val);&amp;#10;    psychoJS.experiment.addData(&quot;block_number&quot;, block_number);&amp;#10;    psychoJS.experiment.addData(&quot;trial_number&quot;, trial_number);&amp;#10;    psychoJS.experiment.addData(&quot;correct&quot;, correct_ans);&amp;#10;    trial_start = false;&amp;#10;    steps_text = steps_count.toString();&amp;#10;} else {&amp;#10;    steps_count += 1;&amp;#10;    steps_in_trial += 1;&amp;#10;    steps_text = steps_count.toString();&amp;#10;    move_pigeon(step_mean_val, step_std_val);&amp;#10;    pigeon_steps.push(pigeon_shown_x);&amp;#10;    update_status(true, false, true, false, task_objective);&amp;#10;}&amp;#10;if ((reversals &gt;= N_revs)) {&amp;#10;    endroutine = true;&amp;#10;    move_loop_calibrate.finished = true;&amp;#10;    trial_loop_calibrate.finished = true;&amp;#10;    logitb = (logodds79 / (1 / Math.pow(step_std, 2)));&amp;#10;    high_step_std = (1 / Math.sqrt((logodds90 / logitb)));&amp;#10;    low_step_std = (1 / Math.sqrt((logodds60 / logitb)));&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="# increment score threshold based on absolute performance&amp;#10;if (steps_count == steps_max) and (steps_count &lt; 1500):&amp;#10;    steps_max += 250&amp;#10;elif steps_count &gt;= 1250:&amp;#10;    steps_max = coins_max*STEPS_MAX_PER_TRIAL/coins_gained_per_correct&amp;#10;steps_label = 'Steps Threshold: ' + str(steps_max)&amp;#10; &amp;#10;if trial_start is True: &amp;#10;    # Clear keyboard events&amp;#10;    cr_kbd_response.clearEvents()    &amp;#10;    &amp;#10;    # Default feedback&amp;#10;    message_string = NO_CHOICE_STRING&amp;#10;    choice = 'none'&amp;#10;    &amp;#10;    # Set instruction string&amp;#10;    instruction_string = CHOICE_STRING&amp;#10;    &amp;#10;    # Initialize pigeon variables&amp;#10;    pigeon_flip = 0.1&amp;#10;    pigeon_true_x = ORIGIN_X&amp;#10;    pigeon_shown_x = pigeon_true_x&amp;#10;    pigeon_steps = [pigeon_shown_x]&amp;#10;    &amp;#10;    &amp;#10;    # Randomize direction, set std&amp;#10;    if randint(0,2)==1:&amp;#10;        correct_ans = 'right'&amp;#10;        step_mean_val = abs(step_mean)&amp;#10;    else:&amp;#10;        correct_ans = 'left'&amp;#10;        step_mean_val = -1*abs(step_mean)&amp;#10;    step_std_val = step_std&amp;#10;    &amp;#10;    # Save trial parameters&amp;#10;    thisExp.addData('step_mean_val', step_mean_val)&amp;#10;    thisExp.addData('step_std_val', step_std_val)&amp;#10;    thisExp.addData('block_number', block_number)&amp;#10;    thisExp.addData('trial_number', trial_number)&amp;#10;    thisExp.addData('correct', correct_ans)&amp;#10;&amp;#10;    # Set flag&amp;#10;    trial_start = False&amp;#10;    &amp;#10;    # Update steps text&amp;#10;    steps_text = str(steps_count)&amp;#10;else:&amp;#10;    # Increment the counter and move the pigeon&amp;#10;    steps_count += 1&amp;#10;    steps_in_trial += 1&amp;#10;    &amp;#10;    # Update text&amp;#10;    steps_text = str(steps_count)     &amp;#10;    &amp;#10;    move_pigeon(step_mean_val, step_std_val)&amp;#10;    pigeon_steps.append(pigeon_shown_x)&amp;#10;    # Update steps status&amp;#10;    update_status(True, False, True, False, task_objective)&amp;#10;    &amp;#10;# Check for end of task (target reversals)&amp;#10;if reversals &gt;= N_revs: &amp;#10;    # Drop out&amp;#10;    endroutine = True;&amp;#10;    move_loop_calibrate.finished = True&amp;#10;    trial_loop_calibrate.finished = True&amp;#10;    &amp;#10;    # set stdevs&amp;#10;    logitb = logodds79/(1/(step_std**2))&amp;#10;    high_step_std = 1/sqrt(logodds90/logitb)&amp;#10;    low_step_std = 1/sqrt(logodds60/logitb)" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="var _pj;&amp;#10;function _pj_snippets(container) {&amp;#10;    function in_es6(left, right) {&amp;#10;        if (((right instanceof Array) || ((typeof right) === &quot;string&quot;))) {&amp;#10;            return (right.indexOf(left) &gt; (- 1));&amp;#10;        } else {&amp;#10;            if (((right instanceof Map) || (right instanceof Set) || (right instanceof WeakMap) || (right instanceof WeakSet))) {&amp;#10;                return right.has(left);&amp;#10;            } else {&amp;#10;                return (left in right);&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;    container[&quot;in_es6&quot;] = in_es6;&amp;#10;    return container;&amp;#10;}&amp;#10;_pj = {};&amp;#10;_pj_snippets(_pj);&amp;#10;if ((trial_loop_calibrate.finished === true)) {&amp;#10;    psychoJS.experiment.addData(&quot;pigeon_steps&quot;, pigeon_steps);&amp;#10;    psychoJS.experiment.addData(&quot;coins_count&quot;, coins_count);&amp;#10;    psychoJS.experiment.addData(&quot;steps_count&quot;, steps_count);&amp;#10;    psychoJS.experiment.addData(&quot;choice&quot;, &quot;none&quot;);&amp;#10;    set_block_end_string();&amp;#10;    psychoJS.experiment.addData(&quot;bonus&quot;, bonus_count);&amp;#10;} else {&amp;#10;    if (cr_kbd_response.keys) {&amp;#10;        if (_pj.in_es6(correct_ans, cr_kbd_response.keys)) {&amp;#10;            coins_count += coins_gained_per_correct;&amp;#10;            set_trial_end_string(CORRECT_STRING);&amp;#10;            if (((task_objective === &quot;steps&quot;) || ((task_objective === &quot;score&quot;) &amp;&amp; (coins_count &lt; coins_max)))) {&amp;#10;                update_status(false, true, false, false, (task_objective === &quot;steps&quot;));&amp;#10;            }&amp;#10;        } else {&amp;#10;            coins_count -= coins_lost_per_error;&amp;#10;            steps_count += steps_lost_per_error;&amp;#10;            if ((steps_count &gt;= steps_max)) {&amp;#10;                steps_count = steps_max;&amp;#10;            }&amp;#10;            set_trial_end_string(ERROR_STRING);&amp;#10;        }&amp;#10;        psychoJS.experiment.addData(&quot;pigeon_steps&quot;, pigeon_steps);&amp;#10;        psychoJS.experiment.addData(&quot;coins_count&quot;, coins_count);&amp;#10;        psychoJS.experiment.addData(&quot;steps_count&quot;, steps_count);&amp;#10;        psychoJS.experiment.addData(&quot;choice&quot;, cr_kbd_response.keys);&amp;#10;        if ((exp_type === &quot;snr&quot;)) {&amp;#10;            step_std = noise_staircase(_pj.in_es6(correct_ans, cr_kbd_response.keys), step_std, max_val, min_val, step_size, N_up, N_down);&amp;#10;        }&amp;#10;        if ((((task_objective === &quot;steps&quot;) || ((task_objective === &quot;score&quot;) &amp;&amp; (coins_count &lt; coins_max))) || (task_objective === &quot;calibrate&quot;))) {&amp;#10;            update_status(false, true, true, false, task_objective);&amp;#10;            cr_kbd_response.clearEvents();&amp;#10;            trial_number += 1;&amp;#10;            move_loop_calibrate.finished = true;&amp;#10;        }&amp;#10;    } else {&amp;#10;        if ((move_loop_calibrate.thisRepN === STEPS_MAX_PER_TRIAL)) {&amp;#10;            move_loop_calibrate.finished = true;&amp;#10;            set_trial_end_string(NO_CHOICE_STRING);&amp;#10;            trial_number += 1;&amp;#10;            psychoJS.experiment.addData(&quot;pigeon_steps&quot;, pigeon_steps);&amp;#10;            psychoJS.experiment.addData(&quot;coins_count&quot;, coins_count);&amp;#10;            psychoJS.experiment.addData(&quot;steps_count&quot;, steps_count);&amp;#10;            psychoJS.experiment.addData(&quot;choice&quot;, &quot;none&quot;);&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="if trial_loop_calibrate.finished is True:    &amp;#10;    # Save results&amp;#10;    thisExp.addData('pigeon_steps', pigeon_steps)&amp;#10;    thisExp.addData('coins_count', coins_count)&amp;#10;    thisExp.addData('steps_count', steps_count)&amp;#10;    thisExp.addData('choice', 'none')&amp;#10;&amp;#10;    # Drop out of this block loop&amp;#10;    set_block_end_string()&amp;#10;    thisExp.addData('bonus', bonus_count)&amp;#10;&amp;#10;elif cr_kbd_response.keys:&amp;#10;        &amp;#10;    # Parse answer and update status&amp;#10;    if correct_ans in cr_kbd_response.keys:&amp;#10;        coins_count += coins_gained_per_correct&amp;#10;        set_trial_end_string(CORRECT_STRING)&amp;#10;        if (task_objective == 'steps') or (task_objective == 'score' and coins_count &lt; coins_max):&amp;#10;            update_status(False, True, False, False, task_objective == 'steps')&amp;#10;    else:&amp;#10;        coins_count -= coins_lost_per_error&amp;#10;        steps_count += steps_lost_per_error&amp;#10;        if steps_count &gt;= steps_max:&amp;#10;            steps_count = steps_max&amp;#10;        set_trial_end_string(ERROR_STRING)&amp;#10;    &amp;#10;    # Save results&amp;#10;    thisExp.addData('pigeon_steps', pigeon_steps)&amp;#10;    thisExp.addData('coins_count', coins_count)&amp;#10;    thisExp.addData('steps_count', steps_count)    &amp;#10;    thisExp.addData('choice', cr_kbd_response.keys)&amp;#10;    &amp;#10;    # manage staircase&amp;#10;    if exp_type == 'snr':&amp;#10;        step_std = noise_staircase((correct_ans in cr_kbd_response.keys), step_std, max_val, min_val, step_size, N_up, N_down)&amp;#10;       &amp;#10;    # update status&amp;#10;    if (task_objective == 'steps') or (task_objective == 'score' and coins_count &lt; coins_max) or (task_objective == 'calibrate'):&amp;#10;        update_status(False, True, True, False, task_objective)&amp;#10;        &amp;#10;        # Clear keyboard events&amp;#10;        cr_kbd_response.clearEvents()    &amp;#10;&amp;#10;        # Drop out of pigeon movement loop&amp;#10;        trial_number += 1&amp;#10;        move_loop_calibrate.finished = True&amp;#10;elif move_loop_calibrate.thisRepN == (STEPS_MAX_PER_TRIAL):&amp;#10;    move_loop_calibrate.finished = True&amp;#10;    set_trial_end_string(NO_CHOICE_STRING)&amp;#10;    trial_number += 1&amp;#10;    # Save results if maxed out trial&amp;#10;    thisExp.addData('pigeon_steps', pigeon_steps)&amp;#10;    thisExp.addData('coins_count', coins_count)&amp;#10;    thisExp.addData('steps_count', steps_count)&amp;#10;    thisExp.addData('choice', 'none')&amp;#10;    &amp;#10;" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="cr_code_update" valType="code" updates="None" name="name" />
      </CodeComponent>
      <PolygonComponent name="cr_polygon_abscissa" plugin="None">
