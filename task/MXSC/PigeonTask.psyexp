    <Routine name="simple_demo">
      <CodeComponent name="sd_code_update" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="if (demo_start) {&amp;#10;    pigeon_flip = 0.1;&amp;#10;    pigeon_true_x = 0;&amp;#10;    pigeon_shown_x = pigeon_true_x;&amp;#10;    if ((util.randint(0, 2) === 0)) {&amp;#10;        step_mean_val = ((- 1) * Math.abs(step_mean));&amp;#10;    } else {&amp;#10;        step_mean_val = Math.abs(step_mean);&amp;#10;    }&amp;#10;    step_std_val = step_std;&amp;#10;    demo_start = false;&amp;#10;} else {&amp;#10;    if (((step_mean === 0) &amp;&amp; (steps_count === 50))) {&amp;#10;        simple_demo_trial_loop.finished = true;&amp;#10;    }&amp;#10;    if (((pigeon_true_x &gt; (- EDGE_DISTANCE)) &amp;&amp; (pigeon_true_x &lt; EDGE_DISTANCE))) {&amp;#10;        move_pigeon(step_mean_val, step_std_val);&amp;#10;        steps_count += 1;&amp;#10;    } else {&amp;#10;        simple_demo_trial_loop.finished = true;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="if demo_start:&amp;#10;    # initialize pigeon variables&amp;#10;    pigeon_flip = 0.1&amp;#10;    pigeon_true_x = 0&amp;#10;    pigeon_shown_x = pigeon_true_x&amp;#10;    &amp;#10;    # Randomize direction, set std&amp;#10;    if randint(0,2)==0:&amp;#10;        step_mean_val = -1*abs(step_mean)&amp;#10;    else:&amp;#10;        step_mean_val = abs(step_mean)&amp;#10;    step_std_val = step_std&amp;#10;    # unset flag&amp;#10;    demo_start = False&amp;#10;else:&amp;#10;    # Check for completion&amp;#10;    if step_mean == 0 and steps_count == 50:&amp;#10;        simple_demo_trial_loop.finished = True&amp;#10;    if pigeon_true_x &gt; -EDGE_DISTANCE and pigeon_true_x &lt; EDGE_DISTANCE:&amp;#10;        move_pigeon(step_mean_val, step_std_val)&amp;#10;        steps_count += 1&amp;#10;    else:&amp;#10;        simple_demo_trial_loop.finished = True" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="if (simple_demo_trial_loop.finished) {&amp;#10;    steps_count = 0;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="if simple_demo_trial_loop.finished:&amp;#10;    steps_count = 0" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="sd_code_update" valType="code" updates="None" name="name" />
      </CodeComponent>
