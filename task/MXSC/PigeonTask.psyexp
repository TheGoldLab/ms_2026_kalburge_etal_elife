        <Param val="var _pj;&amp;#10;function _pj_snippets(container) {&amp;#10;    function in_es6(left, right) {&amp;#10;        if (((right instanceof Array) || ((typeof right) === &quot;string&quot;))) {&amp;#10;            return (right.indexOf(left) &gt; (- 1));&amp;#10;        } else {&amp;#10;            if (((right instanceof Map) || (right instanceof Set) || (right instanceof WeakMap) || (right instanceof WeakSet))) {&amp;#10;                return right.has(left);&amp;#10;            } else {&amp;#10;                return (left in right);&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;    container[&quot;in_es6&quot;] = in_es6;&amp;#10;    return container;&amp;#10;}&amp;#10;_pj = {};&amp;#10;_pj_snippets(_pj);&amp;#10;if ((trial_start === true)) {&amp;#10;    if ((block_type === &quot;mixed&quot;)) {&amp;#10;        step_mean = step_mean_vals[0];&amp;#10;        step_std = step_std_vals[0];&amp;#10;        env_img = low_env_img;&amp;#10;        rv = rng_trial_type();&amp;#10;        if ((rv &gt; 0.5)) {&amp;#10;            step_mean = step_mean_vals[1];&amp;#10;            step_std = step_std_vals[1];&amp;#10;            env_img = high_env_img;&amp;#10;        }&amp;#10;    }&amp;#10;    if (_pj.in_es6(&quot;change_low&quot;, block_type)) {&amp;#10;        switch_time = low_switch_time;&amp;#10;    } else {&amp;#10;        if (_pj.in_es6(&quot;change_high&quot;, block_type)) {&amp;#10;            switch_time = high_switch_time;&amp;#10;        }&amp;#10;    }&amp;#10;    otr_kbd_response.clearEvents();&amp;#10;    message_string = NO_CHOICE_STRING;&amp;#10;    choice = &quot;none&quot;;&amp;#10;    instruction_string = CHOICE_STRING;&amp;#10;    pigeon_flip = 0.1;&amp;#10;    pigeon_true_x = ORIGIN_X;&amp;#10;    pigeon_shown_x = pigeon_true_x;&amp;#10;    pigeon_steps = [pigeon_shown_x];&amp;#10;    if (!(block_type === &quot;mixed&quot;)) {&amp;#10;        env_img = (&quot;Resources/&quot; + tc_img_file);&amp;#10;    }&amp;#10;    if (_pj.in_es6(&quot;change_low&quot;, block_type)) {&amp;#10;        step_mean = step_mean_vals[0];&amp;#10;        step_std = step_std_vals[0];&amp;#10;    } else {&amp;#10;        if (_pj.in_es6(&quot;change_high&quot;, block_type)) {&amp;#10;            step_mean = step_mean_vals[1];&amp;#10;            step_std = step_std_vals[1];&amp;#10;        }&amp;#10;    }&amp;#10;    if (changepoint) {&amp;#10;        env_bar_height = ENV_BAR_HEIGHT;&amp;#10;    }&amp;#10;    switch_occurred = false;&amp;#10;    coins_gained_per_correct = tc_coins_gained_per_correct;&amp;#10;    coins_lost_per_error = tc_coins_lost_per_error;&amp;#10;    coins_count += coins_paid_to_start_trial;&amp;#10;    steps_count += steps_taken_to_start_trial;&amp;#10;    steps_in_trial = 0;&amp;#10;    if ((util.randint(0, 2) === 1)) {&amp;#10;        correct_ans = &quot;right&quot;;&amp;#10;        step_mean_val = Math.abs(step_mean);&amp;#10;    } else {&amp;#10;        correct_ans = &quot;left&quot;;&amp;#10;        step_mean_val = ((- 1) * Math.abs(step_mean));&amp;#10;    }&amp;#10;    step_std_val = step_std;&amp;#10;    psychoJS.experiment.addData(&quot;step_mean_val&quot;, step_mean_val);&amp;#10;    psychoJS.experiment.addData(&quot;step_std_val&quot;, step_std_val);&amp;#10;    psychoJS.experiment.addData(&quot;block_number&quot;, block_number);&amp;#10;    psychoJS.experiment.addData(&quot;trial_number&quot;, trial_number);&amp;#10;    psychoJS.experiment.addData(&quot;correct&quot;, correct_ans);&amp;#10;    if (changepoint) {&amp;#10;        psychoJS.experiment.addData(&quot;switch_time&quot;, switch_time);&amp;#10;    }&amp;#10;    trial_start = false;&amp;#10;    if ((task_objective === &quot;steps&quot;)) {&amp;#10;        steps_text = (steps_max - steps_count).toString();&amp;#10;    } else {&amp;#10;        if ((task_objective === &quot;score&quot;)) {&amp;#10;            steps_text = steps_count.toString();&amp;#10;        }&amp;#10;    }&amp;#10;    coins_text = coins_count.toString();&amp;#10;    if (changepoint) {&amp;#10;        env_text = (switch_time - steps_in_trial).toString();&amp;#10;    }&amp;#10;    update_status(false, false, false, changepoint, task_objective);&amp;#10;} else {&amp;#10;    steps_count += 1;&amp;#10;    steps_in_trial += 1;&amp;#10;    if (((changepoint === true) &amp;&amp; (steps_in_trial &lt; switch_time))) {&amp;#10;        env_text = (switch_time - steps_in_trial).toString();&amp;#10;    } else {&amp;#10;        env_text = &quot;&quot;;&amp;#10;    }&amp;#10;    if ((task_objective === &quot;steps&quot;)) {&amp;#10;        steps_text = (steps_max - steps_count).toString();&amp;#10;    } else {&amp;#10;        if ((task_objective === &quot;score&quot;)) {&amp;#10;            steps_text = steps_count.toString();&amp;#10;        }&amp;#10;    }&amp;#10;    if (((changepoint === true) &amp;&amp; (switch_occurred === false))) {&amp;#10;        if (_pj.in_es6(&quot;high&quot;, block_type)) {&amp;#10;            if ((steps_in_trial === high_switch_time)) {&amp;#10;                env_bar_height = 0;&amp;#10;                env_img = low_env_img;&amp;#10;                switch_occurred = true;&amp;#10;                step_mean_val = ((correct_ans === &quot;right&quot;) ? Math.abs(step_mean_vals[0]) : ((- 1) * Math.abs(step_mean_vals[0])));&amp;#10;                step_std_val = step_std_vals[0];&amp;#10;            }&amp;#10;        } else {&amp;#10;            if (_pj.in_es6(&quot;low&quot;, block_type)) {&amp;#10;                if ((steps_in_trial === low_switch_time)) {&amp;#10;                    env_bar_height = 0;&amp;#10;                    env_img = high_env_img;&amp;#10;                    switch_occurred = true;&amp;#10;                    step_mean_val = ((correct_ans === &quot;right&quot;) ? Math.abs(step_mean_vals[1]) : ((- 1) * Math.abs(step_mean_vals[1])));&amp;#10;                    step_std_val = step_std_vals[1];&amp;#10;                }&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;    move_pigeon(step_mean_val, step_std_val);&amp;#10;    pigeon_steps.push(pigeon_shown_x);&amp;#10;    update_status(true, false, true, changepoint, task_objective);&amp;#10;}&amp;#10;if ((steps_count &gt;= steps_max)) {&amp;#10;    endroutine = true;&amp;#10;    move_loop.finished = true;&amp;#10;    trial_loop.finished = true;&amp;#10;    if (_pj.in_es6(&quot;fixed_low&quot;, block_type)) {&amp;#10;        let rt_trimmed = trim_warmup_trials(RT_low);&amp;#10;        low_switch_time = calculate_median(rt_trimmed);&amp;#10;        let exclusion_reason = check_rt_extremity(rt_trimmed);&amp;#10;        if (exclusion_reason !== null) {&amp;#10;            should_exclude_participant = true;&amp;#10;            exclusion_message = (exclusion_reason === &quot;too_fast&quot;) ? RT_TOO_FAST_MESSAGE : RT_TOO_SLOW_MESSAGE;&amp;#10;            experiment_loop.finished = true;&amp;#10;        }&amp;#10;    } else {&amp;#10;        if (_pj.in_es6(&quot;fixed_high&quot;, block_type)) {&amp;#10;            let rt_trimmed = trim_warmup_trials(RT_high);&amp;#10;            high_switch_time = calculate_median(rt_trimmed);&amp;#10;            let exclusion_reason = check_rt_extremity(rt_trimmed);&amp;#10;            if (exclusion_reason !== null) {&amp;#10;                should_exclude_participant = true;&amp;#10;                exclusion_message = (exclusion_reason === &quot;too_fast&quot;) ? RT_TOO_FAST_MESSAGE : RT_TOO_SLOW_MESSAGE;&amp;#10;                experiment_loop.finished = true;&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="if trial_start is True: &amp;#10;    # mixed block: randomly choose step vals&amp;#10;    if block_type == &quot;mixed&quot;:&amp;#10;        # step_mean_vals[0]/[1] are the low/high-SNR magnitudes (see the&amp;#10;        # &quot;fixed&quot; push at block start); env_img mirrors the same&amp;#10;        # low_env_img/high_env_img convention used for the changepoint&amp;#10;        # switch below, so the SNR is visibly signaled on every trial, not&amp;#10;        # just held at the block's own (otherwise-unused) tc_img_file.&amp;#10;        step_mean = step_mean_vals[0]&amp;#10;        step_std = step_std_vals[0]&amp;#10;        env_img = low_env_img&amp;#10;        rv = rng_trial_type();&amp;#10;        if rv &gt; 0.5:&amp;#10;            step_mean = step_mean_vals[1]&amp;#10;            step_std = step_std_vals[1]&amp;#10;            env_img = high_env_img&amp;#10;    &amp;#10;    if 'change_low' in block_type:&amp;#10;        switch_time = low_switch_time&amp;#10;    elif 'change_high' in block_type:&amp;#10;        switch_time = high_switch_time&amp;#10;    # Clear keyboard events&amp;#10;    otr_kbd_response.clearEvents()    &amp;#10;        &amp;#10;    # Default feedback&amp;#10;    message_string = NO_CHOICE_STRING&amp;#10;    choice = 'none'&amp;#10;    &amp;#10;    # Set instruction string&amp;#10;    instruction_string = CHOICE_STRING&amp;#10;    &amp;#10;    # Initialize pigeon variables&amp;#10;    pigeon_flip = 0.1&amp;#10;    pigeon_true_x = ORIGIN_X&amp;#10;    pigeon_shown_x = pigeon_true_x&amp;#10;    pigeon_steps = [pigeon_shown_x]&amp;#10;    &amp;#10;    # ensure appropriate step values and img at beginning of each trial&amp;#10;    # Mixed block already set env_img above, per-trial, from the actual&amp;#10;    # drawn SNR -- don't overwrite it with the block's static tc_img_file.&amp;#10;    if block_type != &quot;mixed&quot;:&amp;#10;        env_img = 'Resources/' + tc_img_file&amp;#10;    if &quot;change_low&quot; in block_type:&amp;#10;        step_mean = step_mean_vals[0]&amp;#10;        step_std = step_std_vals[0]&amp;#10;    elif &quot;change_high&quot; in block_type:&amp;#10;        step_mean = step_mean_vals[1]&amp;#10;        step_std = step_std_vals[1]&amp;#10;    if changepoint:&amp;#10;        env_bar_height = ENV_BAR_HEIGHT&amp;#10;    switch_occurred = False&amp;#10;    coins_gained_per_correct = tc_coins_gained_per_correct&amp;#10;    coins_lost_per_error = tc_coins_lost_per_error&amp;#10;    &amp;#10;    &amp;#10;    # Pay to play&amp;#10;    coins_count += coins_paid_to_start_trial&amp;#10;    steps_count += steps_taken_to_start_trial&amp;#10;    steps_in_trial = 0&amp;#10;    # Randomize direction, set std&amp;#10;    if randint(0,2)==1:&amp;#10;        correct_ans = 'right'&amp;#10;        step_mean_val = abs(step_mean)&amp;#10;    else:&amp;#10;        correct_ans = 'left'&amp;#10;        step_mean_val = -1*abs(step_mean)&amp;#10;    step_std_val = step_std&amp;#10;    # Save trial parameters&amp;#10;    thisExp.addData('step_mean_val', step_mean_val)&amp;#10;    thisExp.addData('step_std_val', step_std_val)&amp;#10;    thisExp.addData('block_number', block_number)&amp;#10;    thisExp.addData('trial_number', trial_number)&amp;#10;    thisExp.addData('correct', correct_ans)&amp;#10;    # Record the changepoint step directly, per trial, so downstream&amp;#10;    # analysis reads it rather than re-deriving it from RTs (which would&amp;#10;    # need to independently replicate the exact trimming/rounding used&amp;#10;    # to compute low_switch_time/high_switch_time above).&amp;#10;    if changepoint:&amp;#10;        thisExp.addData('switch_time', switch_time)&amp;#10;    # Set flag&amp;#10;    trial_start = False&amp;#10;    &amp;#10;    if task_objective == 'steps':&amp;#10;        steps_text = str(steps_max - steps_count)&amp;#10;    elif task_objective == 'score':&amp;#10;        steps_text = str(steps_count)&amp;#10;    coins_text = str(coins_count)&amp;#10;    &amp;#10;    # change block bar update&amp;#10;    if changepoint:&amp;#10;        env_text = str(switch_time - steps_in_trial)&amp;#10;    update_status(False,False,False,changepoint,task_objective)&amp;#10;else:&amp;#10;    # Increment the counter and move the pigeon&amp;#10;    steps_count += 1&amp;#10;    steps_in_trial += 1&amp;#10;    # Update text&amp;#10;    if changepoint is True and steps_in_trial &lt; switch_time:&amp;#10;        env_text = str(switch_time - steps_in_trial)&amp;#10;    else:&amp;#10;        env_text = ''&amp;#10;&amp;#10;    # update steps text&amp;#10;    if task_objective == 'steps':&amp;#10;        steps_text = str(steps_max - steps_count)&amp;#10;    elif task_objective == 'score':&amp;#10;        steps_text = str(steps_count)&amp;#10;    &amp;#10;    # change blocks: code in change point at &amp;#10;    # predetermined RT based on fixed blocks&amp;#10;    if changepoint is True and switch_occurred is False: &amp;#10;        if &quot;high&quot; in block_type:&amp;#10;            if steps_in_trial == high_switch_time :&amp;#10;                env_bar_height = 0&amp;#10;                env_img = low_env_img&amp;#10;                switch_occurred = True&amp;#10;                # Preserve this trial's direction (correct_ans) across the changepoint;&amp;#10;                # only the SNR (magnitude) changes. step_mean_vals[i] holds unsigned&amp;#10;                # per-SNR magnitudes, so the sign must be re-applied here (previously it&amp;#10;                # was not, forcing post-changepoint drift to always be positive).&amp;#10;                step_mean_val = abs(step_mean_vals[0]) if correct_ans == 'right' else -1*abs(step_mean_vals[0])&amp;#10;                step_std_val = step_std_vals[0]&amp;#10;        elif &quot;low&quot; in block_type:&amp;#10;            if steps_in_trial == low_switch_time:&amp;#10;                env_bar_height = 0&amp;#10;                env_img = high_env_img&amp;#10;                switch_occurred = True&amp;#10;                step_mean_val = abs(step_mean_vals[1]) if correct_ans == 'right' else -1*abs(step_mean_vals[1])&amp;#10;                step_std_val = step_std_vals[1]&amp;#10;    move_pigeon(step_mean_val, step_std_val)&amp;#10;    pigeon_steps.append(pigeon_shown_x)&amp;#10;    # Update steps status&amp;#10;    update_status(True, False, True, changepoint, task_objective)&amp;#10;&amp;#10;&amp;#10;# Check for end of task (no more steps)&amp;#10;if steps_count &gt;= steps_max:&amp;#10;    # Drop out&amp;#10;    endroutine = True;&amp;#10;    move_loop.finished = True&amp;#10;    trial_loop.finished = True&amp;#10;    &amp;#10;    # record relevant median RT for low and high blocks (median only, per task-code&amp;#10;    # standardization; rounded to an integer step count; computed after discarding the&amp;#10;    # first RT_WARMUP_TRIALS_TO_DISCARD trials of the block -- see calculate_median /&amp;#10;    # trim_warmup_trials). Also screens for an unusable RT distribution (too fast/slow)&amp;#10;    # and ends the session early if so -- see check_rt_extremity.&amp;#10;    if &quot;fixed_low&quot; in block_type:&amp;#10;        rt_trimmed = trim_warmup_trials(RT_low)&amp;#10;        low_switch_time = calculate_median(rt_trimmed)&amp;#10;        exclusion_reason = check_rt_extremity(rt_trimmed)&amp;#10;        if exclusion_reason is not None:&amp;#10;            should_exclude_participant = True&amp;#10;            exclusion_message = RT_TOO_FAST_MESSAGE if exclusion_reason == 'too_fast' else RT_TOO_SLOW_MESSAGE&amp;#10;            experiment_loop.finished = True&amp;#10;    elif &quot;fixed_high&quot; in block_type:&amp;#10;        rt_trimmed = trim_warmup_trials(RT_high)&amp;#10;        high_switch_time = calculate_median(rt_trimmed)&amp;#10;        exclusion_reason = check_rt_extremity(rt_trimmed)&amp;#10;        if exclusion_reason is not None:&amp;#10;            should_exclude_participant = True&amp;#10;            exclusion_message = RT_TOO_FAST_MESSAGE if exclusion_reason == 'too_fast' else RT_TOO_SLOW_MESSAGE&amp;#10;            experiment_loop.finished = True&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="var _pj;&amp;#10;function _pj_snippets(container) {&amp;#10;    function in_es6(left, right) {&amp;#10;        if (((right instanceof Array) || ((typeof right) === &quot;string&quot;))) {&amp;#10;            return (right.indexOf(left) &gt; (- 1));&amp;#10;        } else {&amp;#10;            if (((right instanceof Map) || (right instanceof Set) || (right instanceof WeakMap) || (right instanceof WeakSet))) {&amp;#10;                return right.has(left);&amp;#10;            } else {&amp;#10;                return (left in right);&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;    container[&quot;in_es6&quot;] = in_es6;&amp;#10;    return container;&amp;#10;}&amp;#10;_pj = {};&amp;#10;_pj_snippets(_pj);&amp;#10;if ((trial_loop.finished === true)) {&amp;#10;    if ((task_objective === &quot;steps&quot;)) {&amp;#10;        steps_count = steps_max;&amp;#10;    }&amp;#10;    psychoJS.experiment.addData(&quot;pigeon_steps&quot;, pigeon_steps);&amp;#10;    psychoJS.experiment.addData(&quot;coins_count&quot;, coins_count);&amp;#10;    psychoJS.experiment.addData(&quot;steps_count&quot;, steps_count);&amp;#10;    psychoJS.experiment.addData(&quot;choice&quot;, &quot;none&quot;);&amp;#10;    set_block_end_string();&amp;#10;    psychoJS.experiment.addData(&quot;bonus&quot;, bonus_count);&amp;#10;} else {&amp;#10;    if (otr_kbd_response.keys) {&amp;#10;        if (_pj.in_es6(correct_ans, otr_kbd_response.keys)) {&amp;#10;            coins_count += coins_gained_per_correct;&amp;#10;            set_trial_end_string(CORRECT_STRING);&amp;#10;            if (((task_objective === &quot;steps&quot;) || ((task_objective === &quot;score&quot;) &amp;&amp; (coins_count &lt; coins_max)))) {&amp;#10;                update_status(false, true, false, _pj.in_es6(&quot;change&quot;, block_type), (task_objective === &quot;steps&quot;));&amp;#10;            }&amp;#10;        } else {&amp;#10;            coins_count -= coins_lost_per_error;&amp;#10;            steps_count += steps_lost_per_error;&amp;#10;            set_trial_end_string(ERROR_STRING);&amp;#10;        }&amp;#10;        psychoJS.experiment.addData(&quot;pigeon_steps&quot;, pigeon_steps);&amp;#10;        psychoJS.experiment.addData(&quot;coins_count&quot;, coins_count);&amp;#10;        psychoJS.experiment.addData(&quot;steps_count&quot;, steps_count);&amp;#10;        psychoJS.experiment.addData(&quot;choice&quot;, otr_kbd_response.keys);&amp;#10;        if (((task_objective === &quot;steps&quot;) || ((task_objective === &quot;score&quot;) &amp;&amp; (coins_count &lt; coins_max)))) {&amp;#10;            update_status(false, true, true, changepoint, task_objective);&amp;#10;            otr_kbd_response.clearEvents();&amp;#10;            if (_pj.in_es6(&quot;fixed_high&quot;, block_type)) {&amp;#10;                RT_high.push(pigeon_steps.length);&amp;#10;            } else {&amp;#10;                if (_pj.in_es6(&quot;fixed_low&quot;, block_type)) {&amp;#10;                    RT_low.push(pigeon_steps.length);&amp;#10;                }&amp;#10;            }&amp;#10;            trial_number += 1;&amp;#10;            move_loop.finished = true;&amp;#10;        }&amp;#10;    } else {&amp;#10;        if ((move_loop.thisRepN === (STEPS_MAX_PER_TRIAL - 1))) {&amp;#10;            move_loop.finished = true;&amp;#10;            set_trial_end_string(NO_CHOICE_STRING);&amp;#10;            trial_number += 1;&amp;#10;            psychoJS.experiment.addData(&quot;pigeon_steps&quot;, pigeon_steps);&amp;#10;            psychoJS.experiment.addData(&quot;coins_count&quot;, coins_count);&amp;#10;            psychoJS.experiment.addData(&quot;steps_count&quot;, steps_count);&amp;#10;            psychoJS.experiment.addData(&quot;choice&quot;, &quot;none&quot;);&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="if trial_loop.finished is True:&amp;#10;    if task_objective == 'steps':&amp;#10;        # Cap # of steps&amp;#10;        steps_count = steps_max&amp;#10;        &amp;#10;    # Save results&amp;#10;    thisExp.addData('pigeon_steps', pigeon_steps)&amp;#10;    thisExp.addData('coins_count', coins_count)&amp;#10;    thisExp.addData('steps_count', steps_count)&amp;#10;    thisExp.addData('choice', 'none')&amp;#10;&amp;#10;    # Drop out of this block loop&amp;#10;    set_block_end_string()&amp;#10;    thisExp.addData('bonus', bonus_count)&amp;#10;    &amp;#10;elif otr_kbd_response.keys:&amp;#10;        &amp;#10;    # Parse answer and update status&amp;#10;    if correct_ans in otr_kbd_response.keys:&amp;#10;        coins_count += coins_gained_per_correct&amp;#10;        set_trial_end_string(CORRECT_STRING)&amp;#10;        if (task_objective == 'steps') or (task_objective == 'score' and coins_count &lt; coins_max):&amp;#10;            update_status(False, True, False, &quot;change&quot; in block_type, task_objective == 'steps')&amp;#10;    else:&amp;#10;        coins_count -= coins_lost_per_error&amp;#10;        steps_count += steps_lost_per_error&amp;#10;        set_trial_end_string(ERROR_STRING)&amp;#10;    &amp;#10;    # Save results&amp;#10;    thisExp.addData('pigeon_steps', pigeon_steps)&amp;#10;    thisExp.addData('coins_count', coins_count)&amp;#10;    thisExp.addData('steps_count', steps_count)    &amp;#10;    thisExp.addData('choice', otr_kbd_response.keys)&amp;#10;    &amp;#10;    # update status&amp;#10;    if (task_objective == 'steps') or (task_objective == 'score' and coins_count &lt; coins_max):&amp;#10;        update_status(False, True, True, changepoint, task_objective)&amp;#10;        &amp;#10;        # Clear keyboard events&amp;#10;        otr_kbd_response.clearEvents()    &amp;#10;&amp;#10;        # record fixed block RTs for RT calibration in change blocks&amp;#10;        if &quot;fixed_high&quot; in block_type:&amp;#10;            RT_high.append(len(pigeon_steps))&amp;#10;        elif &quot;fixed_low&quot; in block_type:&amp;#10;            RT_low.append(len(pigeon_steps))&amp;#10;        &amp;#10;        # Drop out of pigeon movement loop&amp;#10;        trial_number += 1&amp;#10;        move_loop.finished = True&amp;#10;        &amp;#10;    &amp;#10;elif move_loop.thisRepN == (STEPS_MAX_PER_TRIAL-1):&amp;#10;    move_loop.finished = True&amp;#10;    set_trial_end_string(NO_CHOICE_STRING)&amp;#10;    trial_number += 1&amp;#10;    # Save results if maxed out trial&amp;#10;    thisExp.addData('pigeon_steps', pigeon_steps)&amp;#10;    thisExp.addData('coins_count', coins_count)&amp;#10;    thisExp.addData('steps_count', steps_count)&amp;#10;    thisExp.addData('choice', 'none')&amp;#10;    &amp;#10;" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="otr_code_update" valType="code" updates="None" name="name" />
      </CodeComponent>
