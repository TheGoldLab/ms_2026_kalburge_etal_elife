    <Routine name="status_instruction_setup">
      <CodeComponent name="sis_code_setup" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="status_show = true;&amp;#10;pigeon_show = true;&amp;#10;seeds_show = true;&amp;#10;pigeon_flip = 0.1;&amp;#10;pigeon_true_x = 0;&amp;#10;pigeon_shown_x = pigeon_true_x;&amp;#10;box_show = sic_box_show;&amp;#10;box_width = sic_box_width;&amp;#10;box_height = sic_box_height;&amp;#10;box_x = sic_box_x;&amp;#10;box_y = sic_box_y;&amp;#10;message_string = sic_message;&amp;#10;SEEDS_SCALE = sic_seeds_scale;&amp;#10;task_objective = sic_objective;&amp;#10;if ((sic_img_file !== null)) {&amp;#10;    env_img = (&quot;Resources/&quot; + sic_img_file);&amp;#10;} else {&amp;#10;    env_img = high_env_img;&amp;#10;}&amp;#10;steps_label = &quot;Steps remaining&quot;;&amp;#10;if ((task_objective === &quot;score&quot;)) {&amp;#10;    steps_label = (&quot;Steps Threshold: &quot; + steps_max.toString());&amp;#10;} else {&amp;#10;    if ((task_objective === &quot;steps&quot;)) {&amp;#10;        steps_label = &quot;Steps Remaining&quot;;&amp;#10;    }&amp;#10;}&amp;#10;if ((task_objective === &quot;steps&quot;)) {&amp;#10;    steps_text = (steps_max - steps_count).toString();&amp;#10;} else {&amp;#10;    if ((task_objective === &quot;score&quot;)) {&amp;#10;        steps_text = steps_count.toString();&amp;#10;    }&amp;#10;}&amp;#10;coins_text = coins_count.toString();&amp;#10;steps_count += 1;&amp;#10;update_status(true, true, true, false, task_objective);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="# Set conditions&amp;#10;status_show = True&amp;#10;pigeon_show = True&amp;#10;seeds_show = True&amp;#10;pigeon_flip = 0.1&amp;#10;pigeon_true_x = 0&amp;#10;pigeon_shown_x = pigeon_true_x&amp;#10;&amp;#10;&amp;#10;box_show = sic_box_show&amp;#10;box_width = sic_box_width&amp;#10;box_height = sic_box_height&amp;#10;box_x = sic_box_x&amp;#10;box_y = sic_box_y&amp;#10;message_string = sic_message&amp;#10;SEEDS_SCALE = sic_seeds_scale&amp;#10;task_objective = sic_objective&amp;#10;if sic_img_file != None:&amp;#10;    env_img = 'Resources/' + sic_img_file&amp;#10;else:&amp;#10;    env_img = high_env_img&amp;#10;    &amp;#10;steps_label = 'Steps remaining'&amp;#10;if task_objective == 'score':&amp;#10;    steps_label = 'Steps Threshold: ' + str(steps_max)&amp;#10;elif task_objective == 'steps':&amp;#10;    steps_label = 'Steps Remaining'&amp;#10;#    steps_text = '0'&amp;#10;&amp;#10;&amp;#10;if task_objective == 'steps':&amp;#10;    steps_text = str(steps_max - steps_count)&amp;#10;elif task_objective == 'score':&amp;#10;    steps_text = str(steps_count)&amp;#10;coins_text = str(coins_count)&amp;#10;&amp;#10;steps_count += 1&amp;#10;&amp;#10;&amp;#10;update_status(True, True, True, False, task_objective)" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="sis_code_setup" valType="code" updates="None" name="name" />
      </CodeComponent>
    </Routine>
    <Routine name="start_task">
      <CodeComponent name="st_code_setup" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="var _pj;&amp;#10;function _pj_snippets(container) {&amp;#10;    function in_es6(left, right) {&amp;#10;        if (((right instanceof Array) || ((typeof right) === &quot;string&quot;))) {&amp;#10;            return (right.indexOf(left) &gt; (- 1));&amp;#10;        } else {&amp;#10;            if (((right instanceof Map) || (right instanceof Set) || (right instanceof WeakMap) || (right instanceof WeakSet))) {&amp;#10;                return right.has(left);&amp;#10;            } else {&amp;#10;                return (left in right);&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;    container[&quot;in_es6&quot;] = in_es6;&amp;#10;    return container;&amp;#10;}&amp;#10;_pj = {};&amp;#10;_pj_snippets(_pj);&amp;#10;trial_start = true;&amp;#10;trial_number = 1;&amp;#10;steps_count = 0;&amp;#10;coins_count = 0;&amp;#10;last_coins_count = coins_count;&amp;#10;last_steps_count = steps_count;&amp;#10;RT_high = [];&amp;#10;RT_low = [];&amp;#10;switch_occurred = false;&amp;#10;block_type = tc_block_type;&amp;#10;instructions_type = block_type.split(&quot;_&quot;)[0];&amp;#10;task_objective = tc_task_objective;&amp;#10;step_mean = tc_step_mean;&amp;#10;step_std = tc_step_std;&amp;#10;steps_max = tc_steps_max;&amp;#10;steps_taken_to_start_trial = tc_steps_taken_to_start_trial;&amp;#10;steps_lost_per_error = tc_steps_lost_per_error;&amp;#10;coins_max = tc_coins_max;&amp;#10;coins_paid_to_start_trial = tc_coins_paid_to_start_trial;&amp;#10;coins_lost_per_error = tc_coins_lost_per_error;&amp;#10;coins_gained_per_correct = tc_coins_gained_per_correct;&amp;#10;changepoint = tc_changepoint;&amp;#10;env_img = (&quot;Resources/&quot; + tc_img_file);&amp;#10;if (_pj.in_es6(&quot;fixed&quot;, block_type)) {&amp;#10;    step_mean_vals.push(step_mean);&amp;#10;    step_mean_vals.sort();&amp;#10;    step_std_vals.push(step_std);&amp;#10;    step_std_vals.sort();&amp;#10;}&amp;#10;if ((changepoint === false)) {&amp;#10;    env_text = &quot;&quot;;&amp;#10;}&amp;#10;instructions_conditions_file = ((&quot;Resources/Pigeon_&quot; + instructions_type) + &quot;_InstructionsConditions.xlsx&quot;);&amp;#10;online_trials_count = 10000;&amp;#10;block_number += 1;&amp;#10;test_block_number += 1;&amp;#10;message_string = (((&quot;Testing Block &quot; + test_block_number.toString()) + &quot; of &quot;) + experiment_loop.trialList.length.toString());&amp;#10;pigeon_flip = 0.1;&amp;#10;pigeon_true_x = 0;&amp;#10;pigeon_shown_x = pigeon_true_x;&amp;#10;if ((task_objective === &quot;steps&quot;)) {&amp;#10;    steps_label = &quot;Steps remaining&quot;;&amp;#10;    steps_text = (steps_max - steps_count).toString();&amp;#10;} else {&amp;#10;    if ((task_objective === &quot;score&quot;)) {&amp;#10;        steps_label = (&quot;Steps Threshold: &quot; + steps_max.toString());&amp;#10;        steps_text = steps_count.toString();&amp;#10;    }&amp;#10;}&amp;#10;update_status(true, true, true, changepoint, task_objective);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="# Setup task&amp;#10;trial_start = True&amp;#10;trial_number = 1&amp;#10;steps_count = 0&amp;#10;coins_count = 0&amp;#10;last_coins_count = coins_count&amp;#10;last_steps_count = steps_count&amp;#10;RT_high = []&amp;#10;RT_low = []&amp;#10;switch_occurred = False&amp;#10;&amp;#10;&amp;#10;# Set globals from conditions file variables&amp;#10;block_type = tc_block_type&amp;#10;instructions_type = block_type.split(&quot;_&quot;)[0]&amp;#10;task_objective = tc_task_objective&amp;#10;step_mean = tc_step_mean&amp;#10;step_std = tc_step_std&amp;#10;steps_max = tc_steps_max&amp;#10;steps_taken_to_start_trial = tc_steps_taken_to_start_trial&amp;#10;steps_lost_per_error = tc_steps_lost_per_error&amp;#10;coins_max = tc_coins_max&amp;#10;coins_paid_to_start_trial = tc_coins_paid_to_start_trial&amp;#10;coins_lost_per_error = tc_coins_lost_per_error&amp;#10;coins_gained_per_correct = tc_coins_gained_per_correct&amp;#10;changepoint = tc_changepoint&amp;#10;env_img = 'Resources/' + tc_img_file&amp;#10;&amp;#10;# fixed blocks: save mean and std values over experiment&amp;#10;if &quot;fixed&quot; in block_type:&amp;#10;    step_mean_vals.append(step_mean)&amp;#10;    step_mean_vals.sort()&amp;#10;    &amp;#10;    step_std_vals.append(step_std)&amp;#10;    step_std_vals.sort()&amp;#10;&amp;#10;if changepoint is False:&amp;#10;    env_text = ''&amp;#10;&amp;#10;# Get Instructions Conditions file name&amp;#10;instructions_conditions_file = 'Resources/Pigeon_' + instructions_type + '_InstructionsConditions.xlsx'&amp;#10;&amp;#10;# Control flow&amp;#10;online_trials_count = 10000&amp;#10;&amp;#10;# New block&amp;#10;block_number += 1&amp;#10;test_block_number += 1&amp;#10;message_string = 'Testing Block ' + str(test_block_number) + ' of ' + str(len(experiment_loop.trialList))&amp;#10;&amp;#10;# Initialize pigeon variables&amp;#10;pigeon_flip = 0.1&amp;#10;pigeon_true_x = 0&amp;#10;pigeon_shown_x = pigeon_true_x&amp;#10;&amp;#10;#if 'change_low' in task_type:&amp;#10;#    switch_time = low_switch_time&amp;#10;#    steps_max = low_steps_thresh+50&amp;#10;#elif 'change_high' in task_type:&amp;#10;#    switch_time = high_switch_time&amp;#10;#    steps_max = high_steps_thresh+50&amp;#10;&amp;#10;if task_objective == 'steps':&amp;#10;    steps_label = 'Steps remaining'&amp;#10;    steps_text = str(steps_max - steps_count)&amp;#10;elif task_objective == 'score':&amp;#10;    steps_label = 'Steps Threshold: ' + str(steps_max)&amp;#10;    steps_text = str(steps_count)&amp;#10;    &amp;#10;# Update status graphics/text&amp;#10;update_status(True, True, True, changepoint, task_objective)" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="st_code_setup" valType="code" updates="None" name="name" />
      </CodeComponent>
    </Routine>
