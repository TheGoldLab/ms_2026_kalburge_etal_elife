        <Param val="trial_start = true;&amp;#10;trial_number = 1;&amp;#10;steps_count = 0;&amp;#10;coins_count = 0;&amp;#10;last_coins_count = coins_count;&amp;#10;last_steps_count = steps_count;&amp;#10;switch_occurred = false;&amp;#10;task_objective = &quot;calibrate&quot;;&amp;#10;steps_max = 500;&amp;#10;steps_taken_to_start_trial = 0;&amp;#10;steps_lost_per_error = 0;&amp;#10;coins_max = 300;&amp;#10;coins_paid_to_start_trial = 0;&amp;#10;coins_lost_per_error = 2;&amp;#10;coins_gained_per_correct = 2;&amp;#10;if_switch = false;&amp;#10;SEEDS_SCALE = 1;&amp;#10;steps_label = (&quot;Steps Threshold: &quot; + steps_max.toString());&amp;#10;steps_text = steps_count.toString();&amp;#10;task_type = tc_task_type;&amp;#10;step_mean = MEAN_STEP_SIZE;&amp;#10;step_std = tc_step_std;&amp;#10;N_revs = tc_n_revs;&amp;#10;N_up = tc_N_up;&amp;#10;N_down = tc_N_down;&amp;#10;step_size = tc_step_size;&amp;#10;max_val = tc_max_val;&amp;#10;min_val = tc_min_val;&amp;#10;logitb = 0;&amp;#10;newprec = 0;&amp;#10;if ((tc_img_file !== null)) {&amp;#10;    env_img = (&quot;Resources/&quot; + tc_img_file);&amp;#10;} else {&amp;#10;    env_img = high_env_img;&amp;#10;}&amp;#10;if (dummy_mode) {&amp;#10;    calibrate_trials_count = 0;&amp;#10;} else {&amp;#10;    calibrate_trials_count = 10000;&amp;#10;}&amp;#10;block_number += 1;&amp;#10;cal_block_number += 1;&amp;#10;message_string = ((((&quot;Practice Block &quot; + cal_block_number.toString()) + &quot; of &quot;) + calibration_loop.trialList.length.toString()) + &quot;\nPerforming well in this block will help you to maximize your reward rate over this experiment. Therefore, your goal should be to earn as many coins as possible.&quot;);&amp;#10;pigeon_flip = 0.1;&amp;#10;pigeon_true_x = 0;&amp;#10;pigeon_shown_x = pigeon_true_x;&amp;#10;update_status(true, true, true, false, task_objective);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="# Setup task&amp;#10;trial_start = True&amp;#10;trial_number = 1&amp;#10;steps_count = 0&amp;#10;coins_count = 0&amp;#10;last_coins_count = coins_count&amp;#10;last_steps_count = steps_count&amp;#10;switch_occurred = False;&amp;#10;task_objective = 'calibrate'&amp;#10;steps_max = 500&amp;#10;steps_taken_to_start_trial = 0&amp;#10;steps_lost_per_error = 0&amp;#10;coins_max = 300&amp;#10;coins_paid_to_start_trial = 0&amp;#10;coins_lost_per_error = 2&amp;#10;coins_gained_per_correct = 2&amp;#10;if_switch = False&amp;#10;SEEDS_SCALE = 1&amp;#10;steps_label = 'Steps Threshold: ' + str(steps_max)&amp;#10;steps_text = str(steps_count)&amp;#10;&amp;#10;# Set globals from conditions file variables&amp;#10;task_type = tc_task_type&amp;#10;step_mean = MEAN_STEP_SIZE&amp;#10;step_std = tc_step_std&amp;#10;N_revs = tc_n_revs&amp;#10;N_up = tc_N_up&amp;#10;N_down = tc_N_down&amp;#10;step_size = tc_step_size&amp;#10;max_val = tc_max_val&amp;#10;min_val = tc_min_val&amp;#10;logitb = 0&amp;#10;newprec = 0&amp;#10;if tc_img_file != None:&amp;#10;    env_img = 'Resources/' + tc_img_file&amp;#10;else:&amp;#10;    env_img = high_env_img&amp;#10;&amp;#10;# Control flow&amp;#10;if dummy_mode:&amp;#10;    calibrate_trials_count = 0&amp;#10;else:&amp;#10;    calibrate_trials_count = 10000&amp;#10;&amp;#10;# New block&amp;#10;block_number += 1&amp;#10;cal_block_number += 1&amp;#10;message_string = 'Practice Block ' + str(cal_block_number) + ' of ' + str(len(calibration_loop.trialList)) + '\nPerforming well in this block will help you to maximize your reward rate over this experiment. Therefore, your goal should be to earn as many coins as possible.'&amp;#10;&amp;#10;# Initialize pigeon variables&amp;#10;pigeon_flip = 0.1&amp;#10;pigeon_true_x = 0&amp;#10;pigeon_shown_x = pigeon_true_x&amp;#10;&amp;#10;# Update status graphics/text&amp;#10;update_status(True, True, True, False, task_objective)" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
